            // 城镇自建房：radio 单选绑定（把选中值写入隐藏域）
            document.querySelectorAll('#editModalForm .urban-radio').forEach(function(radio) {
                radio.addEventListener('change', function() {
                    const idx = this.dataset.idx;
                    const hidden = document.querySelector('#editModalForm .urban-radio-hidden[data-idx="' + idx + '"]');
                    if (hidden) hidden.value = this.value;
                    // 通过 idx 找到字段名，区分不同字段的"其他/其它"
                    const fieldLabel = (rows[idx] && rows[idx][0]) || '';
                    // 房屋权属"其他"：显示/隐藏附加输入框
                    const otherInput = document.getElementById('houseRightOtherInput');
                    if (otherInput) {
                        otherInput.style.display = (fieldLabel === '房屋权属' && this.value === '其他') ? '' : 'none';
                    }
                    // 土地性质"国有土地-其他"：显示/隐藏附加输入框
                    const landOtherInput = document.getElementById('landRightOtherInput');
                    if (landOtherInput) {
                        landOtherInput.style.display = (fieldLabel === '土地性质' && this.value === '国有土地-其他') ? '' : 'none';
                    }
                    // 结构类型"其它"：显示/隐藏附加下拉框
                    const structOtherSelect = document.getElementById('structTypeOtherSelect');
                    if (structOtherSelect) {
                        structOtherSelect.style.display = (fieldLabel === '结构类型' && this.value === '其它') ? '' : 'none';
                    }
                });
            });
            // 城镇自建房：checkbox 多选绑定（把选中值用 , 连接写入隐藏域）
            document.querySelectorAll('#editModalForm .urban-checkbox').forEach(function(cb) {
                cb.addEventListener('change', function() {
                    const idx = this.dataset.idx;
                    const checked = document.querySelectorAll('#editModalForm .urban-checkbox[data-idx="' + idx + '"]:checked');
                    const vals = Array.prototype.map.call(checked, function(c) { return c.value; });
                    const hidden = document.querySelector('#editModalForm .urban-checkbox-hidden[data-idx="' + idx + '"]');
                    if (hidden) hidden.value = vals.join(',');
                });
            });

            // 城镇自建房：监听"房屋性质"切换，自动刷新表单字段（住宅↔非住宅）
            if (isUrbanHouse() && editModalSubTab === 'jbxx') {
                document.querySelectorAll('#editModalForm .urban-radio').forEach(function(radio) {
                    const formItem = radio.closest('.form-item');
                    const label = formItem && formItem.querySelector('.form-label');
                    if (label && label.textContent === '房屋性质') {
                        radio.addEventListener('change', function() {
                            // 切换时先把当前所有 form-input 值写回 rows（保留用户已填内容）
                            document.querySelectorAll('#editModalForm .form-input').forEach(function(inp) {
                                const i = parseInt(inp.dataset.idx, 10);
                                if (rows && rows[i]) rows[i][1] = inp.value;
                            });
                            // 重新渲染表单（按新房屋性质）
                            renderEditModalForm();
                        });
                    }
                });
            }
            // 添加多地址：克隆主行结构（清空值）追加到末尾
            document.querySelectorAll('#editModalForm .road-add-multi').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    const idx = this.dataset.idx;
                    const list = document.querySelector('#editModalForm .road-addr-list[data-idx="' + idx + '"]');
                    if (!list) return;
                    const existingRows = list.querySelectorAll('.road-addr-row');
                    const newSubIdx = existingRows.length;
                    // 用模板构建新行
                    const inputStyle = 'padding:6px 8px;border:1px solid #d9d9d9;border-radius:4px;font-size:13px;';
                    const newRowHtml =
