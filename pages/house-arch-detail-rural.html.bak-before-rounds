            // 注意：data-idx 必须保留原始索引，否则 saveCommonEdit 会写错位
            let columnsArr = data.columns;
            let origIdxArr = data.columns.map((_, i) => i); // 显示索引 -> 原始索引 的映射
            if (key === 'assessment') {
                origIdxArr = columnsArr.map((c, i) => c === '隐患动态整治状态' ? -1 : i).filter(i => i >= 0);
                columnsArr = origIdxArr.map(i => columnsArr[i]);
            }
            const isImageUrl = (v) => v && v !== '—' && v !== '-' && (v.startsWith('data:image') || v.startsWith('http') || v.endsWith('.jpg') || v.endsWith('.jpeg') || v.endsWith('.png') || v.endsWith('.gif'));
            const photoIndexes = columnsArr.map((c, i) => (c && c.includes('照片')) ? i : -1).filter(i => i >= 0);
            const gridHtml = columnsArr.map((c, i) => {
                const origIdx = origIdxArr[i]; // 写入 data-idx 用的真实索引
                let inputHtml = '';
                let fullWidth = '';
                if (c === '鉴定结论') {
                    const val = rows[origIdx] || '';
                    const judgeOptions = ['A级', 'B级', 'C级', 'D级'];
                    // 兼容历史值：C级（局部危险）→ C级
                    const normalize = (v) => {
                        if (!v) return '';
                        const m = v.match(/^([ABCD])级/);
                        return m ? (m[1] + '级') : v;
                    };
                    const curVal = normalize(val);
                    const optsHtml = judgeOptions.map(opt => {
                        const selected = curVal === opt ? ' selected' : '';
                        return '<option value="' + opt + '"' + selected + '>' + opt + '</option>';
                    }).join('');
                    inputHtml = '<select class="form-input" data-idx="' + origIdx + '">' +
                        '<option value="">请选择</option>' +
                        optsHtml +
                        '</select>';
                } else if (photoIndexes.includes(i)) {
                    const val = rows[origIdx] || '';
                    const imageUrls = val.split(',').map(s => s.trim()).filter(isImageUrl);
                    let thumbHtml = '';
                    if (imageUrls.length) {
                        thumbHtml = '<div class="file-thumb-preview">' + imageUrls.map(u => '<img src="' + u + '" alt="预览" onclick="viewPhotoOnline(\'' + u + '\')">').join('') + '</div>';
