        function addCrudRecord(moduleKey) {
            const cfg = crudConfigs[moduleKey];
            if (!cfg) return;
            const s = currentHouseArch;
            const list = (getNestedValue(s, cfg.dataPath) || []).slice();
            const now = new Date();
            const pad = n => String(n).padStart(2, '0');
            const ts = now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate()) + ' ' + pad(now.getHours()) + ':' + pad(now.getMinutes());
            const newRec = {};
            cfg.fields.forEach(f => {
                if (f.key === 'startTime' || f.key === 'patrolDate' || f.key === 'inspectDate' || f.key === 'identifyDate' || f.key === 'drillDate' || f.key === 'startDate') {
                    newRec[f.key] = ts;
                } else if (f.type === 'select') {
                    newRec[f.key] = f.options[0];
                } else {
                    newRec[f.key] = '';
                }
            });
            list.push(newRec);
            setNestedValue(s, cfg.dataPath, list);
            saveCurrentHouseArch(s);
            renderContent();
            setTimeout(() => openCrudModal(moduleKey, list.length - 1), 100);
        }

