            // 房屋安全状况查看页：标题 + 两个图片字段
            let safeStatusViewHtml = '';
            if (!isUrbanHouse() && currentSubTab === 'safeStatus') {
                const safeRows = dynamicBasic.safeStatus || [];
                const getSafeVal = (label) => {
