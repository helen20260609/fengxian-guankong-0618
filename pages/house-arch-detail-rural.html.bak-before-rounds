        .ct-node-body .photo-grid img { width: 64px; height: 64px; object-fit: cover; border-radius: 4px; border: 1px solid var(--border); cursor: pointer; }
        .ct-node-empty { color: var(--text-secondary); font-size: 13px; padding: 12px 0; }

        /* 专家评审区 */
        .expert-opinion-panel { border: 1px solid var(--border); border-radius: 6px; padding: 14px 16px; background: #fff; margin-top: 12px; }
        .expert-opinion-title { font-size: 13px; font-weight: 600; color: var(--major); margin-bottom: 10px; display: flex; align-items: center; gap: 6px; }
        .expert-select-row { display: flex; gap: 8px; align-items: stretch; }
        .expert-select-row .form-input { flex: 1; }
        .expert-select-btn { display: inline-flex; align-items: center; gap: 6px; padding: 0 12px; border: 1px solid var(--primary); border-radius: 4px; background: var(--primary); color: #fff; font-size: 13px; cursor: pointer; white-space: nowrap; }
        .expert-select-btn:hover { background: var(--primary-dark); }

        .project-file-list { display: flex; flex-direction: column; gap: 6px; margin-top: 8px; }
        .project-file-item { display: flex; align-items: center; gap: 8px; padding: 6px 8px; background: #fafbfc; border: 1px solid var(--border); border-radius: 4px; font-size: 12px; color: var(--text-primary); }
        .project-file-item i { color: var(--primary); }
        .project-file-remove { margin-left: auto; width: 20px; height: 20px; border: none; background: transparent; color: var(--danger); cursor: pointer; display: flex; align-items: center; justify-content: center; border-radius: 4px; }
        .project-file-remove:hover { background: #fce8e6; }

        .map-picker-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 10001; justify-content: center; align-items: flex-start; padding: 40px 16px; overflow-y: auto; }
