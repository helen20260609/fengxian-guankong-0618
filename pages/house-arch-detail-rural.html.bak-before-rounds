        // 审核报告文件上传：读取为 dataURL 写回文本框
        function handleAuditReportUpload(input) {
            const file = input.files && input.files[0];
            if (!file) return;
            if (file.size > 5 * 1024 * 1024) {
                alert('文件大小不能超过 5MB');
                input.value = '';
                return;
            }
            const reader = new FileReader();
            reader.onload = e => {
                const wrap = input.closest('.file-upload-wrap');
                const txt = wrap.querySelector('[data-audit-key="report"]');
                if (txt) {
                    txt.value = e.target.result;
                    let tip = wrap.querySelector('.report-upload-tip');
                    if (!tip) {
                        tip = document.createElement('div');
                        tip.className = 'report-upload-tip';
                        tip.style.cssText = 'font-size:12px;color:var(--safe);';
                        wrap.appendChild(tip);
                    }
                    tip.innerHTML = '<i class="fas fa-check-circle"></i> 已选择：' + file.name + '（' + (file.size / 1024).toFixed(1) + ' KB）';
                }
            };
            reader.readAsDataURL(file);
        }

        // 事件委托：让 acceptAuditEditForm 里的 dropzone 点击/拖拽能触发文件选择
        (function bindAuditReportDropzone() {
            const form = document.getElementById('acceptAuditEditForm');
            if (!form) return;
            form.addEventListener('click', e => {
                const dz = e.target.closest('.file-upload-dropzone');
                if (!dz) return;
                const wrap = dz.closest('.file-upload-wrap');
                const input = wrap && wrap.querySelector('.file-upload-input');
                if (input) input.click();
            });
            ['dragenter', 'dragover'].forEach(ev => {
                form.addEventListener(ev, e => {
                    const dz = e.target.closest('.file-upload-dropzone');
                    if (!dz) return;
                    e.preventDefault();
                    dz.classList.add('dragover');
                });
            });
            ['dragleave', 'drop'].forEach(ev => {
                form.addEventListener(ev, e => {
                    const dz = e.target.closest('.file-upload-dropzone');
                    if (!dz) return;
                    e.preventDefault();
                    dz.classList.remove('dragover');
                });
            });
            form.addEventListener('drop', e => {
                const dz = e.target.closest('.file-upload-dropzone');
                if (!dz) return;
                const wrap = dz.closest('.file-upload-wrap');
                const input = wrap && wrap.querySelector('.file-upload-input');
                if (!input) return;
                if (e.dataTransfer.files && e.dataTransfer.files.length) {
                    input.files = e.dataTransfer.files;
                    handleAuditReportUpload(input);
                }
            });
        })();

