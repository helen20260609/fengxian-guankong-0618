        function saveBasicEdit() {
            if (editModalSubTab === 'designConstruction') {
                const list = currentHouseArch.designConstructionRecords || [];
                const idx = Math.min(recordViewState.designConstruction || 0, Math.max(list.length - 1, 0));
                const rec = list[idx];
                if (rec) {
                    document.querySelectorAll('#editModalForm .form-input[data-field]').forEach(function(input) {
                        const field = input.dataset.field;
                        const v = input.value;
                        if (field === 'hasProfessionalDesign' || field === 'hasQualificationTeam') {
                            rec[field] = (v === '是' || v === 'true' || v === true);
                        } else {
                            rec[field] = v;
                        }
                    });
                }
                currentSubTab = editModalSubTab;
                delete currentHouseArch._syncedAt;
                saveCurrentHouseArch(currentHouseArch);
                closeBasicEditModal();
                renderSidebar();
                renderContent();
                return;
            }
            const inputs = document.querySelectorAll('#editModalForm .form-input');
            // 农房基本信息：按截图重做的表单，需要按控件类型分别保存
            if (!isUrbanHouse() && editModalSubTab === 'jbxx') {
                const rows = getBasicData().jbxx || [];
                // 辅助：按 label 写回（找不到则追加）
                const setVal = (label, val) => {
                    const idx = rows.findIndex(r => r[0] === label);
                    if (idx !== -1) { rows[idx][1] = val; }
                    else { rows.push([label, val]); }
                };
                // 1) radio 单选
                document.querySelectorAll('#editModalForm .rural-radio-group[data-field]').forEach(function(grp) {
                    const label = grp.dataset.field;
                    const checked = grp.querySelector('input[type=radio]:checked');
                    setVal(label, checked ? checked.value : '');
                });
                // 2) checkbox 多选（出租特殊处理：合并人数）
                document.querySelectorAll('#editModalForm .rural-checkbox-group[data-field]').forEach(function(grp) {
                    const label = grp.dataset.field;
                    const vals = [];
                    grp.querySelectorAll('input[type=checkbox]:checked').forEach(function(cb) {
                        if (cb.dataset.rent === '1') {
                            const numInput = grp.querySelector('.rural-rent-num');
                            const num = numInput && numInput.value ? numInput.value : '';
                            vals.push('出租(居住:' + num + '人)');
                        } else {
                            vals.push(cb.value);
                        }
                    });
                    setVal(label, vals.join('、'));
                });
                // 3) "其他"输入框
                document.querySelectorAll('#editModalForm .rural-other-input[data-field]').forEach(function(inp) {
                    setVal(inp.dataset.field, inp.value);
                });
                // 4) 普通 input（data-rural-field）
                document.querySelectorAll('#editModalForm input[data-rural-field]').forEach(function(inp) {
                    setVal(inp.dataset.ruralField, inp.value);
                });
                // 5) 三段路号（东海二组 + 路/组 + 238 + 号）
                const ra = document.querySelector('#editModalForm .rural-road-a');
                const rb = document.querySelector('#editModalForm .rural-road-b');
                if (ra && rb) {
                    const merged = (ra.value || '') + (rb.value || '') + (rb.value ? '号' : '');
                    setVal('路号信息', merged);
                }
                // 6) 三级联动
                const district = '奉贤区';
                const town = document.querySelector('#editModalForm .rural-region-town');
                const village = document.querySelector('#editModalForm .rural-region-village');
                if (town) {
                    let regionVal = district + (town.value || '');
                    if (village && village.value) regionVal += village.value;
                    setVal('所在区域', regionVal);
                }
                // 7) 唯一标识（只读，不需要写回）
            } else if (isUrbanHouse() && editModalSubTab === 'jbxx') {
                const urbanData = getBasicData();
                // 收集所有分组字段（common + residential + commercial），按 label 匹配写回
                const allGroups = [
                    urbanData.jbxx_common || [],
                    urbanData.jbxx_residential || [],
                    urbanData.jbxx_commercial || []
                ];
                // 当前编辑界面展示的字段（含顺序）
                const displayRows = getJbxxRows();
                inputs.forEach(input => {
                    const idx = parseInt(input.dataset.idx, 10);
                    if (displayRows && displayRows[idx]) {
                        const label = displayRows[idx][0];
                        // 在所有分组中找到该 label 并更新
                        let updated = false;
                        for (let g = 0; g < allGroups.length; g++) {
                            const group = allGroups[g];
                            for (let i = 0; i < group.length; i++) {
                                if (group[i][0] === label) {
                                    group[i][1] = input.value;
                                    updated = true;
                                    break;
                                }
                            }
                            if (updated) break;
                        }
                    }
                });
                // 特殊字段：房屋权属其他内容（data-extra-label 方式保存）
                document.querySelectorAll('#editModalForm [data-extra-label]').forEach(function(inp) {
                    const extraLabel = inp.dataset.extraLabel;
                    for (let g = 0; g < allGroups.length; g++) {
                        const group = allGroups[g];
                        for (let i = 0; i < group.length; i++) {
                            if (group[i][0] === extraLabel) {
                                group[i][1] = inp.value;
                                break;
                            }
                        }
                    }
                });
            } else {
                // 其他情况：按原逻辑直接通过 idx 写回
                const rows = getBasicData()[editModalSubTab];
                inputs.forEach(input => {
                    const idx = parseInt(input.dataset.idx, 10);
                    if (rows && rows[idx]) {
                        rows[idx][1] = input.value;
                    }
                });
            }
            currentSubTab = editModalSubTab;
            // 字段库改动持久化到草稿
            currentHouseArch._fieldsLibrary = dumpFieldsLibrary();
            delete currentHouseArch._syncedAt; // 编辑后标记为未同步
            saveCurrentHouseArch(currentHouseArch);
            closeBasicEditModal();
            renderSidebar();
            renderContent();
        }

