                        panelBody.innerHTML = '<div style="padding:20px;text-align:center;color:#999;font-size:13px;">暂无匹配地址</div>';
                    }
                }
                // 点击搜索图标
                document.querySelectorAll('#editModalForm .road-search-icon').forEach(function(icon) {
                    icon.addEventListener('click', function(e) {
                        e.stopPropagation();
                        const idx = this.dataset.idx;
                        const subIdx = this.dataset.subIdx;
                        const panel = document.querySelector('#editModalForm .road-search-panel[data-idx="' + idx + '"]');
                        const panelBody = panel.querySelector('.road-search-panel-body');
                        if (!panel || !panelBody) return;
                        // 标记当前目标行
                        panel.dataset.targetSubIdx = subIdx;
                        // 用当前行路名做筛选
                        const roadInput = this.closest('.road-addr-row').querySelector('.road-name');
                        const filterText = (roadInput && roadInput.value) || '';
                        renderPanel(panelBody, filterText);
                        // 显示/隐藏
                        const isOpen = panel.style.display !== 'none';
                        panel.style.display = isOpen ? 'none' : 'block';
                    });
                });
                // 点击面板行回填
                document.addEventListener('click', function(e) {
                    if (e.target.closest('.road-search-panel-row')) {
                        const row = e.target.closest('.road-search-panel-row');
                        const panel = row.closest('.road-search-panel');
                        const idx = panel.dataset.idx;
                        const subIdx = panel.dataset.targetSubIdx;
                        const targetRow = document.querySelector('#editModalForm .road-addr-row[data-idx="' + idx + '"][data-sub-idx="' + subIdx + '"]');
                        if (targetRow) {
                            targetRow.querySelector('.road-name').value = row.dataset.road || '';
                            targetRow.querySelector('.road-hao').value = row.dataset.hao || '';
                            targetRow.querySelector('.road-dong').value = row.dataset.dong || '';
