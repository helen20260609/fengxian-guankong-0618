        // 内嵌填报表单（编辑/新增共用；scope='edit'|'new'，editIdx=-1 表示新增）
        function renderMeasureFormHtml(kind, scope, editIdx) {
            const s = currentHouseArch;
            const isManage = kind === 'manage';
            const list = isManage ? (s.manageRecords || []) : (s.projectRecords || []);
            const rec = (scope === 'edit' && editIdx >= 0) ? (list[editIdx] || {}) : {};
            const WATER_HINT = '需使用移动端现场实地拍摄照片，带地址时间水印！';
            const esc = (v) => String(v === undefined || v === null ? '' : v).replace(/"/g, '&quot;');
            const greenLabel = (label, hint) => '<label class="form-label" style="color:var(--safe);font-weight:600;">' + label + ' *' + (hint ? '<span style="color:#d93025;font-size:12px;margin-left:8px;font-weight:400;">' + hint + '</span>' : '') + '</label>';
            const normalLabel = (label, hint) => '<label class="form-label">' + label + (hint ? '<span style="color:#d93025;font-size:12px;margin-left:8px;font-weight:400;">' + hint + '</span>' : '') + '</label>';
            const dataKey = (f) => 'data-' + scope + '-field="' + f + '"';
            const inputText = (label, f, val, green) =>
                '<div class="form-item">' + (green ? greenLabel(label) : normalLabel(label)) +
                '<input class="form-input" type="text" ' + dataKey(f) + ' value="' + esc(val) + '"></div>';
            const inputDate = (label, f, val, green) =>
                '<div class="form-item">' + (green ? greenLabel(label) : normalLabel(label)) +
                '<input class="form-input" type="date" ' + dataKey(f) + ' value="' + esc(normalizeDateValue(val)) + '"></div>';
            const inputTextarea = (label, f, val, green, hint) =>
                '<div class="form-item form-item-full">' + (green ? greenLabel(label, hint) : normalLabel(label, hint)) +
                '<textarea class="form-input" rows="2" ' + dataKey(f) + '>' + esc(val) + '</textarea></div>';
            const inputSelect = (label, f, val, opts, green) => {
                const optsHtml = opts.map(o => {
                    const v = (typeof o === 'object') ? o.value : o;
                    const t = (typeof o === 'object') ? o.label : o;
                    return '<option value="' + v + '"' + (String(val) === String(v) ? ' selected' : '') + '>' + t + '</option>';
                }).join('');
                return '<div class="form-item">' + (green ? greenLabel(label) : normalLabel(label)) +
                    '<select class="form-input" ' + dataKey(f) + '>' + optsHtml + '</select></div>';
            };
            const inputPhoto = (label, f, val, green, hint, accept) => {
                const raw = Array.isArray(val) ? val.join(',') : String(val || '');
                const urls = raw.split(',').map(t => t.trim()).filter(u => u && u !== '—' && u !== '-');
                const thumbHtml = urls.length ? '<div class="file-thumb-preview">' + urls.map(u => '<img src="' + u + '" alt="预览" onclick="viewPhotoOnline(\'' + u + '\')">').join('') + '</div>' : '';
                const acceptAttr = accept || 'image/*';
                const placeholder = (acceptAttr === 'image/*') ? '图片 URL，逗号分隔 或 点击下方上传' : '附件 URL，逗号分隔 或 点击下方上传';
                return '<div class="form-item form-item-full">' + (green ? greenLabel(label, hint) : normalLabel(label, hint)) +
                    '<div class="file-upload-wrap">' +
                        '<input class="form-input file-url-input" type="text" ' + dataKey(f) + ' data-photo-type="' + (acceptAttr === 'image/*' ? 'image' : 'file') + '" value="' + esc(raw) + '" placeholder="' + placeholder + '">' +
                        '<input class="file-upload-input" type="file" accept="' + acceptAttr + '" multiple onchange="handleMeasureFormUpload(this)">' +
                        '<div class="file-upload-dropzone"><i class="fas fa-cloud-upload-alt"></i> 点击或拖拽上传' + (acceptAttr === 'image/*' ? '图片' : '附件') + '</div>' +
                        thumbHtml +
                    '</div></div>';
            };
            let fieldsHtml = '';
            if (isManage) {
                fieldsHtml =
                    inputTextarea('管理措施', 'measureDesc', rec.measureDesc, true) +
                    inputDate('开始时间', 'startTime', rec.startTime, true) +
                    inputDate('结束时间', 'actualEndTime', rec.actualEndTime || rec.planEndTime) +
                    inputText('负责人信息', 'dutyPerson', rec.dutyPerson, true) +
                    inputText('联系电话', 'phone', rec.phone, true) +
                    inputPhoto('管理措施实施照片', 'implementPhotos', rec.implementPhotos, false, WATER_HINT) +
                    inputPhoto('管理措施完成照片（最少上传两张照片）', 'completePhotos', rec.completePhotos, false, WATER_HINT) +
                    inputSelect('措施是否完成', 'isDone', (rec.isDone === true || rec.isDone === '已完成') ? '已完成' : '进行中', ['进行中', '已完成']) +
                    inputTextarea('备注', 'remark', rec.remark, false) +
                    inputText('填报人', 'reporter', rec.reporter) +
                    inputDate('填报时间', 'reportTime', rec.reportTime);
            } else {
                fieldsHtml =
                    inputText('工程措施', 'projectName', rec.projectName, true) +
                    inputText('实施拟采用的政策路径', 'policyPath', rec.policyPath) +
                    inputText('其他实施拟采用政策路径', 'otherPolicyPath', rec.otherPolicyPath) +
                    inputTextarea('细化工程措施方案', 'planDetail', rec.planDetail, true) +
                    inputPhoto('细化工程措施方案附件', 'planFiles', rec.planFiles, false, '', '*') +
                    inputDate('开始时间', 'startDate', rec.startDate, true) +
                    inputDate('结束时间', 'endDate', rec.endDate) +
                    inputText('负责人信息', 'manager', rec.manager, true) +
                    inputText('联系电话', 'phone', rec.phone, true) +
                    inputPhoto('工程措施实施照片', 'implementPhotos', rec.implementPhotos, false, WATER_HINT) +
                    inputPhoto('工程措施完成照片', 'completePhotos', rec.completePhotos, false, WATER_HINT) +
                    inputSelect('措施是否完成', 'status', rec.status === '已完成' ? '已完成' : '进行中', ['进行中', '已完成']) +
                    inputTextarea('备注', 'remark', rec.remark, false) +
