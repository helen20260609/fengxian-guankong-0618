        function bindSubTabs() {
            document.querySelectorAll('.content-tab').forEach(el => {
                el.addEventListener('click', function() {
                    if (currentSidebar === 'basic') {
                currentSubTab = el.dataset.key;
            } else if (currentSidebar === 'measure') {
                currentMeasureSubTab = el.dataset.key;
            } else if (currentSidebar === 'survey') {
                currentSurveySubTab = el.dataset.key;
            } else if (currentSidebar === 'control') {
                currentControlSubTab = el.dataset.key;
            }
                    renderContent();
                });
            });
            // 记录列表行点击切换激活记录（设计施工信息等）
            document.querySelectorAll('.record-list-row[data-module]').forEach(el => {
                el.addEventListener('click', function() {
                    const module = el.dataset.module;
                    const index = parseInt(el.dataset.index, 10);
                    recordViewState[module] = index;
                    renderContent();
                });
            });
        }

        // =========================================================
        // 整治措施新版式：历史记录折叠卡片 + 内嵌填报表单
        // =========================================================
        // 历史记录头部一行：状态点 + 类型 + 时间范围 + 名称 + [历史] 展开钮
        function renderMeasureHistoryCard(kind, r, idx) {
            const typeLabel = kind === 'manage' ? '管理措施' : '工程措施';
            const icon = kind === 'manage' ? 'fa-shield-alt' : 'fa-hammer';
            const done = (kind === 'manage')
                ? (r.isDone === true || r.isDone === '已完成')
                : (r.status === '已完成');
            const statusText = done ? '措施已完成整治' : '措施进行中';
            const statusColor = done ? 'var(--safe)' : 'var(--major, #fa8c16)';
            const range = (kind === 'manage')
                ? ((r.startTime || '—') + ' ~ ' + (r.actualEndTime || r.planEndTime || '—'))
                : ((r.startDate || '—') + ' ~ ' + (r.endDate || '—'));
            const name = kind === 'manage' ? (r.measureDesc || r.measureType || '—') : (r.projectName || '—');
            let detailHtml = '';
            if (kind === 'manage') {
                const kvM = (label, value, green, fullWidth) => {
                    const v = (value === undefined || value === null || value === '' || value === '—') ? '—' : value;
                    return '<div class="info-item' + (fullWidth ? ' full-width' : '') + '"><div class="info-label">' + label + '</div><div class="info-value ' + (green ? 'rural-only' : (v === '—' ? 'empty' : '')) + '">' + v + '</div></div>';
                };
                const photoRowM = (label, value) => {
                    const raw = (value || '').trim();
                    const urls = raw ? raw.split(',').map(x => x.trim()).filter(u => u && u !== '—' && u !== '-') : [];
                    const photoHtml = urls.length
                        ? '<div class="info-value photo-value" style="display:flex;flex-wrap:wrap;gap:12px;">' + urls.map(u => '<img src="' + u + '" alt="照片" onclick="viewPhotoOnline(\'' + u + '\')" style="width:320px;height:240px;object-fit:cover;border-radius:6px;border:1px solid var(--border);cursor:pointer;">').join('') + '</div>'
                        : '<div class="info-value empty">—</div>';
                    return '<div class="info-item full-width" style="flex-wrap:wrap;">' +
                        '<div style="width:100%;color:#d93025;font-size:12px;margin-bottom:2px;">需使用移动端现场实地拍摄照片，带地址时间水印！</div>' +
                        '<div class="info-label">' + label + '</div>' + photoHtml + '</div>';
                };
                detailHtml = '<div class="info-grid info-grid-2col">' +
                    kvM('管理措施', r.measureDesc, false, true) +
                    kvM('开始时间', r.startTime) +
                    kvM('结束时间', r.actualEndTime || r.planEndTime) +
                    kvM('负责人信息', r.dutyPerson) +
                    kvM('联系电话', r.phone) +
                    photoRowM('管理措施实施照片', r.implementPhotos) +
                    photoRowM('管理措施完成照片（最少上传两张照片）', r.completePhotos) +
                    kvM('措施是否完成', (r.isDone === true || r.isDone === '已完成') ? '已完成' : '进行中') +
                    kvM('备注', r.remark, false, true) +
                    kvM('填报人', r.reporter) +
                    kvM('填报时间', r.reportTime) +
                '</div>';
            } else {
                const kvN = (label, value, fullWidth) => '<div class="info-item' + (fullWidth ? ' full-width' : '') + '"><div class="info-label">' + label + '</div><div class="info-value' + ((value === undefined || value === null || value === '' || value === '—') ? ' empty' : '') + '">' + ((value === undefined || value === null || value === '') ? '—' : value) + '</div></div>';
                const photoField = (label, arr) => '<div class="info-item full-width" style="flex-wrap:wrap;">' +
                    '<div style="width:100%;color:#d93025;font-size:12px;margin-bottom:2px;">需使用移动端现场实地拍摄照片，带地址时间水印！</div>' +
                    '<div class="info-label">' + label + '</div>' +
                    renderPhotoValue(arr, label) +
                '</div>';
                detailHtml = '<div class="info-grid info-grid-2col">' +
                    kvN('工程措施', r.projectName, true) +
                    kvN('实施拟采用的政策路径', r.policyPath) +
                    kvN('其他实施拟采用政策路径', r.otherPolicyPath) +
                    kvN('细化工程措施方案', r.planDetail, true) +
                    kvN('开始时间', r.startDate) +
                    kvN('结束时间', r.endDate) +
                    kvN('负责人信息', r.manager) +
                    kvN('联系电话', r.phone) +
                    photoField('工程措施实施照片', r.implementPhotos) +
                    photoField('工程措施完成照片', r.completePhotos) +
                    kvN('措施是否完成', r.status === '已完成' ? '已完成' : '进行中') +
                    kvN('备注', r.remark) +
                    kvN('填报人', r.reporter) +
                    kvN('填报时间', r.reportTime) +
                '</div>';
            }
            // 历史卡片底部操作：编辑（内嵌表单）/ 删除
            const actionBar =
                '<div style="display:flex;justify-content:flex-end;gap:10px;margin-top:14px;padding-top:12px;border-top:1px solid var(--border);">' +
                    '<button class="bottom-btn" style="padding:4px 12px;font-size:12px;" onclick="event.stopPropagation();openMeasureEditForm(\'' + kind + '\',' + idx + ')"><i class="fas fa-edit"></i> 编辑</button>' +
                    '<button class="bottom-btn" style="padding:4px 12px;font-size:12px;border-color:var(--danger);color:var(--danger);" onclick="event.stopPropagation();deleteMeasureRecord(\'' + kind + '\',' + idx + ')"><i class="fas fa-trash-alt"></i> 删除</button>' +
                '</div>';
            return '<div class="measure-history-card" id="mhCard-' + kind + '-' + idx + '">' +
                '<div class="measure-history-head" onclick="toggleMeasureHistory(\'' + kind + '\',' + idx + ')">' +
                    '<i class="fas fa-circle mh-status" style="font-size:8px;color:' + statusColor + ';"></i>' +
                    '<span style="font-size:13px;color:' + statusColor + ';font-weight:500;">' + statusText + '</span>' +
                    '<span class="mh-type"><i class="fas ' + icon + '"></i> ' + typeLabel + '</span>' +
                    '<span class="mh-range">' + range + '</span>' +
