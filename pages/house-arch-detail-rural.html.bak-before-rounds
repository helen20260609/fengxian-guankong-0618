            document.querySelectorAll('#editModalForm .safe-photo-input').forEach(function(inp) {
                inp.addEventListener('change', function() { handleSafeStatusPhotoUpload(this); });
            });
            // 绑定删除
            document.querySelectorAll('#editModalForm .safe-photo-remove').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    handleSafeStatusPhotoRemove(this);
