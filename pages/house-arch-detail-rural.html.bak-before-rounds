        function renderKeyValueGrid(columns, values, fullWidthFields) {
            const fwFields = fullWidthFields || [];
            return columns.map((c, i) => {
                const isPhoto = c && c.includes('照片');
                const isAttach = c === '鉴定报告';
                const isFullWidth = isPhoto || fwFields.includes(c);
                const val = values[i] || '';
                const isImageUrl = (v) => v && v !== '—' && v !== '-' && (v.startsWith('data:image') || v.startsWith('http') || v.endsWith('.jpg') || v.endsWith('.jpeg') || v.endsWith('.png') || v.endsWith('.gif'));
                let valueHtml = '';
                if (isPhoto && val) {
                    const urls = val.split(',').map(s => s.trim()).filter(isImageUrl);
                    valueHtml = urls.length
                        ? '<div class="info-value photo-value photo-grid">' + urls.map(u => '<img src="' + u + '" alt="照片" onclick="viewPhotoOnline(\'' + u + '\')" style="width:72px;height:72px;object-fit:cover;border-radius:4px;border:1px solid var(--border);cursor:pointer;">').join('') + '</div>'
                        : '<div class="info-value empty">—</div>';
                } else if (isAttach && val && val !== '—' && val !== '-') {
                    const files = projectFilesFromString(val);
                    valueHtml = files.length
                        ? '<div class="info-value attach-list">' + files.map(f => {
                            const isImage = f.url && (f.url.startsWith('data:image') || (f.url.startsWith('http') && /\.(jpg|jpeg|png|gif|bmp|webp)$/i.test(f.url)));
                            const icon = isImage ? 'fa-image' : 'fa-file';
                            const clickAttr = isImage ? ' onclick="viewPhotoOnline(\'' + f.url + '\')" style="cursor:pointer;color:var(--primary);"' : ' style="color:var(--text-primary);"';
                            return '<div style="display:inline-flex;align-items:center;gap:6px;padding:4px 10px;margin:2px 6px 2px 0;background:#f5f7fa;border:1px solid var(--border);border-radius:4px;font-size:13px;">' +
                                '<i class="fas ' + icon + '" style="color:var(--primary);"></i>' +
                                '<span' + clickAttr + '>' + (f.name || '附件') + '</span>' +
                                (f.size ? '<span style="color:#999;font-size:12px;">(' + f.size + ')</span>' : '') +
                                '</div>';
                        }).join('') + '</div>'
                        : '<div class="info-value empty">—</div>';
                } else {
                    valueHtml = '<div class="info-value ' + (val ? '' : 'empty') + '">' + (val || '--') + '</div>';
                }
                return '<div class="info-item ' + (isFullWidth ? 'full-width' : '') + '">' +
                    '<div class="info-label">' + c + '</div>' + valueHtml +
                '</div>';
            }).join('');
        }

        // 整治计划：完全匹配截图布局（2列 + 3组照片）
        function renderPlanContent(s) {
            const data = getTableData().plan;
            const row = (data.rows && data.rows[0]) || [];
            // columns: ['计划开始时间', '计划完成时间', '负责人信息', '联系电话', '整治方案', '是否采取硬隔离', '未硬隔离原因说明', '长期管控照片', '告知承诺书', '书面计划', '备注', '填报人', '填报时间']
            const getV = (i) => row[i] || '';
            // 本地键值渲染（绿色新增字段）
            function kvP(label, value, green) {
                const v = (value === undefined || value === null) ? '' : String(value);
                const isEmpty = v === '' || v === '—' || v === '-';
                const cls = isEmpty ? 'empty' : (green ? 'rural-only' : '');
                return '<div class="info-item"><div class="info-label">' + label + '</div><div class="info-value ' + cls + '">' + (isEmpty ? '—' : v) + '</div></div>';
            }
            // 整行单字段（label 140px + value 自适应）
            function kvFull(label, value, green) {
                const v = (value === undefined || value === null) ? '' : String(value);
                const isEmpty = v === '' || v === '—' || v === '-';
                const cls = isEmpty ? 'empty' : (green ? 'rural-only' : '');
                return '<div class="info-item full-width" style="display:flex;flex-direction:row;align-items:center;gap:12px;">' +
                    '<div class="info-label" style="width:140px;flex-shrink:0;text-align:left;">' + label + '</div>' +
                    '<div class="info-value ' + cls + '" style="flex:1;">' + (isEmpty ? '—' : v) + '</div>' +
                '</div>';
            }
            // 附件渲染（显示文件名和查看链接）- 双列内嵌
            function attachmentRow(label, value) {
                const v = (value === undefined || value === null) ? '' : String(value);
                const isEmpty = v === '' || v === '—' || v === '-';
                if (isEmpty) {
                    return '<div class="info-item"><div class="info-label">' + label + '</div><div class="info-value empty">—</div></div>';
                }
                const fileName = v.split('/').pop().split('\\').pop() || v;
                const displayName = fileName.includes('.') ? fileName : fileName + '.pdf';
                return '<div class="info-item"><div class="info-label">' + label + '</div><div class="info-value"><a href="' + v + '" target="_blank" style="color:#5b7fa6;text-decoration:none;display:inline-flex;align-items:center;gap:6px;"><i class="fas fa-file-pdf" style="color:#e6a23c;"></i>' + displayName + '</a></div></div>';
            }
            // 附件整行渲染（带绿色对勾 + 黄色提示文字）
            function attachmentFullRow(label, value, hint) {
                const v = (value === undefined || value === null) ? '' : String(value);
                const isEmpty = v === '' || v === '—' || v === '-';
                let content = '';
                if (isEmpty) {
                    content = '<div class="info-value empty" style="flex:1;">—</div>';
                } else {
                    const fileName = v.split('/').pop().split('\\').pop() || v;
                    const displayName = fileName.includes('.') ? fileName : fileName + '.pdf';
                    content = '<div class="info-value" style="flex:1;display:flex;align-items:center;gap:10px;flex-wrap:wrap;">' +
                        '<a href="' + v + '" target="_blank" style="color:#5b7fa6;text-decoration:none;display:inline-flex;align-items:center;gap:6px;">' +
                            '<i class="fas fa-file-pdf" style="color:#e6a23c;"></i>' + displayName +
                        '</a>' +
                        '<i class="fas fa-check-circle" style="color:#52c41a;"></i>' +
                        (hint ? '<span style="color:#e6a23c;font-size:13px;line-height:1.5;"><i class="fas fa-exclamation-circle"></i> ' + hint + '</span>' : '') +
                    '</div>';
                }
                return '<div class="info-item full-width" style="margin-top:12px;display:flex;flex-direction:row;align-items:center;gap:12px;">' +
                    '<div class="info-label" style="width:140px;flex-shrink:0;text-align:left;display:flex;align-items:center;justify-content:flex-start;height:100%;min-height:32px;">' + label + '</div>' +
                    content +
                '</div>';
            }
            // 渲染照片网格（full-width）- 标签上下居中显示
            function photoRow(label, value, fallback) {
                let urls = [];
                if (value && value !== '—' && value !== '-') {
                    urls = value.split(',').map(s => s.trim()).filter(u => u.startsWith('data:image') || u.startsWith('http'));
                }
                if (!urls.length && fallback && fallback.length) urls = fallback;
                const inner = urls.length
                    ? '<div class="info-value photo-value photo-grid" style="display:flex;align-items:center;gap:12px;flex:1;">' + urls.map(u => '<img src="' + u + '" alt="' + label + '" onclick="viewPhotoOnline(\'' + u + '\')" style="width:200px;height:150px;object-fit:cover;border-radius:4px;border:1px solid var(--border);cursor:pointer;">').join('') + '</div>'
                    : '<div class="info-value empty" style="flex:1;">—</div>';
                return '<div class="info-item full-width" style="margin-top:12px;display:flex;flex-direction:row;align-items:center;gap:12px;"><div class="info-label" style="width:140px;flex-shrink:0;text-align:left;display:flex;align-items:center;justify-content:flex-start;height:150px;">' + label + '</div>' + inner + '</div>';
            }

            const hintPromise = '产权人或使用权人（无主的，村委会代理）承诺同意硬围挡房屋不再进入使用，启用前需先解危。';
            const hintPlan = '包括无法整治原因、动态监测安排（主体、频次等）以及后续处置计划（是否已断水断电断气、后续有无工程整治计划等），并盖区、街镇印章。';

            // 第 1-2 行：双列
            const grid2col =
                kvP('计划开始时间', getV(0)) + kvP('计划完成时间', getV(1)) +
                kvP('负责人信息', getV(2)) + kvP('联系电话', getV(3));
            // 第 3-4 行：整行单字段
            const fullRows1 =
                kvFull('整治方案', '') + // 占位，下面用 attachmentFullRow 替换
                kvFull('是否采取硬隔离', getV(5));
            // 整治方案（整行附件）
            const planAttachment = attachmentFullRow('整治方案', getV(4));
            // 照片行
            const photoMonitor = photoRow('长期管控照片', getV(7), [mockPlanPhotoSvg('长期管控照片 1 · 管控区域', '#5b7fa6'), mockPlanPhotoSvg('长期管控照片 2 · 警示标识', '#8a6d4b')]);
            // 告知承诺书、书面计划（附件 + 黄色提示）
            const promiseRow = attachmentFullRow('告知承诺书', getV(8), hintPromise);
            const writtenPlanRow = attachmentFullRow('书面计划', getV(9), hintPlan);
            // 备注（整行）
            const remarkRow = kvFull('备注', getV(10));
            // 最后一行：填报人 + 填报时间 双列
            const grid2colLast =
                kvP('填报人', getV(11)) + kvP('填报时间', getV(12));

            return '<div class="info-grid info-grid-2col">' + grid2col + '</div>' +
                '<div class="info-grid info-grid-2col" style="grid-template-columns:1fr;margin-top:0;">' +
                    planAttachment +
                    kvFull('是否采取硬隔离', getV(5)) +
                    photoMonitor +
                    promiseRow +
                    writtenPlanRow +
                    remarkRow +
                '</div>' +
                '<div class="info-grid info-grid-2col" style="margin-top:12px;">' + grid2colLast + '</div>';
        }

