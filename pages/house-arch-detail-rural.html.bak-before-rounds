        .org-qual-grid .org-qual-value { color: var(--text-primary); font-weight: 500; }

        /* 施工过程时间轴 */
        .construction-timeline { position: relative; margin-top: 18px; padding-left: 24px; }
        .construction-timeline::before { content: ''; position: absolute; left: 8px; top: 4px; bottom: 4px; width: 2px; background: var(--border); }
        .ct-node { position: relative; padding-bottom: 18px; }
        .ct-node:last-child { padding-bottom: 0; }
        .ct-node-dot { position: absolute; left: -20px; top: 2px; width: 14px; height: 14px; border-radius: 50%; background: var(--primary); border: 2px solid #fff; box-shadow: 0 0 0 2px var(--primary-light); }
        .ct-node-header { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
        .ct-node-date { font-size: 12px; color: #fff; background: var(--primary); padding: 2px 8px; border-radius: 10px; }
        .ct-node-title { font-size: 14px; font-weight: 600; color: var(--text-primary); }
        .ct-node-body { font-size: 13px; color: var(--text-secondary); line-height: 1.5; margin-left: 2px; }
