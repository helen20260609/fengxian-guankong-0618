        function getNestedValue(obj, path) {
            return path.split('.').reduce((o, p) => o && o[p], obj);
        }
        function setNestedValue(obj, path, value) {
            const parts = path.split('.');
            let cur = obj;
            for (let i = 0; i < parts.length - 1; i++) {
                if (!cur[parts[i]]) cur[parts[i]] = {};
                cur = cur[parts[i]];
            }
            cur[parts[parts.length - 1]] = value;
        }

        function openCrudModal(moduleKey, idx) {
            const cfg = crudConfigs[moduleKey];
            if (!cfg) return;
            const s = currentHouseArch;
            const list = getNestedValue(s, cfg.dataPath) || [];
            const rec = list[idx] || {};
            editingCrudIndex = idx;
            editingCrudModule = moduleKey;
            document.getElementById('crudEditTitle').textContent = '编辑' + cfg.title;
            const greenLabel = (label) => '<label class="form-label" style="color:var(--safe);font-weight:600;">' + label + ' *</label>';
            const textField = (f, val) => {
                let inputHtml;
                if (f.type === 'select') {
                    inputHtml = '<select class="form-input" data-crud-key="' + f.key + '">' +
                        f.options.map(o => '<option value="' + o + '"' + (String(val) === o ? ' selected' : '') + '>' + o + '</option>').join('') + '</select>';
                } else if (f.type === 'textarea') {
                    inputHtml = '<textarea class="form-input" data-crud-key="' + f.key + '" rows="2">' + (val || '') + '</textarea>';
                } else if (f.type === 'photo') {
                    const arr = Array.isArray(val) ? val : (val ? String(val).split(',').map(s => s.trim()).filter(Boolean) : []);
                    const thumbHtml = arr.length ? '<div class="file-thumb-preview">' + arr.map(u => '<img src="' + u + '" alt="预览" onclick="viewPhotoOnline(\'' + u + '\')">').join('') + '</div>' : '';
                    inputHtml = '<input class="form-input" type="text" data-crud-key="' + f.key + '" data-crud-type="photo" value="' + arr.join(',').replace(/"/g, '&quot;') + '" placeholder="图片 URL，逗号分隔">' + thumbHtml;
                } else if (f.key === 'patrolPointCoord') {
                    inputHtml = '<div style="display:flex;gap:8px;align-items:center;">' +
