            surveyEditModalSubTab = currentSurveySubTab;
            renderSurveyEditModalTabs();
            renderSurveyEditModalForm();
            document.getElementById('surveyEditModal').classList.add('open');
        }

        function closeSurveyEditModal() {
            document.getElementById('surveyEditModal').classList.remove('open');
        }

        function renderSurveyEditModalTabs() {
            const wrap = document.getElementById('surveyEditModalTabs');
            const surveySubTabs = getSurveySubTabs();
            const tabsHtml = surveySubTabs.map(tab => {
                const active = tab.key === surveyEditModalSubTab ? 'active' : '';
                return '<div class="content-tab ' + active + '" data-key="' + tab.key + '" data-scope="edit-survey">' +
                    '<i class="fas ' + tab.icon + '"></i> ' + tab.title +
                    '</div>';
            }).join('');
            wrap.innerHTML = tabsHtml;
            wrap.querySelectorAll('.content-tab').forEach(el => {
                el.addEventListener('click', function() {
                    surveyEditModalSubTab = el.dataset.key;
                    renderSurveyEditModalTabs();
                    renderSurveyEditModalForm();
                });
            });
        }

        function renderSurveyEditModalForm() {
            const data = getSurveyData()[surveyEditModalSubTab] || { columns: [], rows: [], extraRows: [] };
            const rows = data.rows[0] || [];
            const ruralOnlyCols = data.ruralOnlyCols || [];
            const extraRows = data.extraRows || [];
            const photoIndex = data.columns.indexOf('排查照片');
            const proofIndex = data.columns.indexOf('上传证明文件');
            const locationIndex = data.columns.indexOf('位置标注');
            const specialIndexes = [photoIndex, proofIndex, locationIndex];
            let gridHtml = data.columns.map((c, i) => {
                let inputHtml = '';
                if (i === locationIndex) {
                    const val = rows[i] || '';
                    inputHtml = '<div class="location-input-wrap">' +
                        '<input class="form-input location-url-input" type="text" data-idx="' + i + '" id="surveyLocationInput" value="' + val.replace(/"/g, '&quot;') + '" placeholder="经度,纬度 或 地址描述">' +
                        '<button type="button" class="location-btn" onclick="openMapPickerForSurvey()"><i class="fas fa-map-marker-alt"></i> 地图选点</button>' +
                        '</div>';
                } else if (i === photoIndex || i === proofIndex) {
                    const val = rows[i] || '';
                    const values = i === photoIndex ? val.split(',').map(s => s.trim()).filter(Boolean) : [val];
                    const isImage = (v) => v && v !== '—' && v !== '-' && (v.startsWith('data:image') || v.startsWith('http') || v.endsWith('.jpg') || v.endsWith('.jpeg') || v.endsWith('.png') || v.endsWith('.gif'));
                    const isPdf = (v) => v && v !== '—' && v !== '-' && (v.startsWith('data:application/pdf') || v.endsWith('.pdf'));
                    const accept = i === proofIndex ? 'application/pdf' : 'image/*';
                    const placeholder = i === proofIndex ? 'PDF URL 或将文件拖入下方' : '图片 URL 或将图片拖入下方';
                    const dropzoneText = i === proofIndex ? '点击或拖拽上传 PDF' : '点击或拖拽上传图片';
                    const multiple = i === photoIndex ? 'multiple' : '';
                    let thumbHtml = '';
                    if (i === photoIndex) {
                        const imageUrls = values.filter(isImage);
                        if (imageUrls.length) {
                            thumbHtml = '<div class="file-thumb-preview">' + imageUrls.map(u => '<img src="' + u + '" alt="预览" onclick="viewPhotoOnline(\'' + u + '\')">').join('') + '</div>';
                        }
                    } else if (isPdf(val)) {
                        thumbHtml = '<div class="file-thumb-preview file-thumb-pdf"><i class="fas fa-file-pdf"></i> PDF 已上传</div>';
                    }
                    inputHtml = '<div class="file-upload-wrap" data-idx="' + i + '">' +
                        '<input class="form-input file-url-input" type="text" data-idx="' + i + '" value="' + val.replace(/"/g, '&quot;') + '" placeholder="' + placeholder + '">' +
                        '<input class="file-upload-input" type="file" accept="' + accept + '" ' + multiple + ' data-idx="' + i + '" onchange="handleSurveyPhotoUpload(this)">' +
                        '<div class="file-upload-dropzone"><i class="fas fa-cloud-upload-alt"></i> ' + dropzoneText + '</div>' +
                        thumbHtml +
                        '</div>';
                } else if (c === '初步判定') {
                    const curVal = rows[i] || '';
                    const judgeOptions = ['未发现安全隐患(第一类)', '存在一定安全隐患(第二类)', '存在严重安全隐患(第三类)'];
                    inputHtml = '<select class="form-select" data-idx="' + i + '">' +
                        '<option value="">请选择</option>' +
                        judgeOptions.map(o => '<option value="' + o + '"' + (curVal === o ? ' selected' : '') + '>' + o + '</option>').join('') +
                        '</select>';
                } else {
                    inputHtml = '<input class="form-input" type="text" data-idx="' + i + '" value="' + (rows[i] || '').replace(/"/g, '&quot;') + '">';
                }
                const fullWidth = specialIndexes.includes(i) ? 'form-item-full' : '';
                const isRuralOnly = ruralOnlyCols.indexOf(c) !== -1;
                const labelStyle = isRuralOnly ? ' style="color:var(--safe);font-weight:600;"' : '';
                return '<div class="form-item ' + fullWidth + '">' +
                    '<label class="form-label"' + labelStyle + '>' + c + '</label>' +
                    inputHtml +
                    '</div>';
            }).join('');

            // extraRows（排查备注/排查照片/上传证明文件等）作为额外字段
            if (extraRows.length) {
                gridHtml += extraRows.map(function(row, rIdx) {
                    return row.map(function(item, cIdx) {
                        const idx = 'extra_' + rIdx + '_' + cIdx;
                        const val = item.value || '';
                        let inputHtml = '';
                        if (item.isPhoto) {
                            const values = val.split(',').map(s => s.trim()).filter(Boolean);
                            const isImage = (v) => v && v !== '—' && v !== '-' && (v.startsWith('data:image') || v.startsWith('http') || v.endsWith('.jpg') || v.endsWith('.jpeg') || v.endsWith('.png') || v.endsWith('.gif'));
                            const imageUrls = values.filter(isImage);
                            let thumbHtml = '';
                            if (imageUrls.length) {
                                thumbHtml = '<div class="file-thumb-preview">' + imageUrls.map(u => '<img src="' + u + '" alt="预览" onclick="viewPhotoOnline(\'' + u + '\')">').join('') + '</div>';
                            }
                            inputHtml = '<div class="file-upload-wrap" data-idx="' + idx + '">' +
                                '<input class="form-input file-url-input" type="text" data-idx="' + idx + '" value="' + val.replace(/"/g, '&quot;') + '" placeholder="图片 URL 或将图片拖入下方">' +
                                '<input class="file-upload-input" type="file" accept="image/*" multiple data-idx="' + idx + '" onchange="handleSurveyExtraPhotoUpload(this)">' +
                                '<div class="file-upload-dropzone"><i class="fas fa-cloud-upload-alt"></i> 点击或拖拽上传图片</div>' +
                                thumbHtml +
                                '</div>';
                        } else {
                            inputHtml = '<input class="form-input" type="text" data-idx="' + idx + '" value="' + val.replace(/"/g, '&quot;') + '">';
                        }
                        return '<div class="form-item form-item-full">' +
                            '<label class="form-label">' + (item.label || '') + '</label>' +
                            inputHtml +
                            '</div>';
                    }).join('');
                }).join('');
            }
            document.getElementById('surveyEditModalForm').innerHTML = '<div class="form-grid">' + gridHtml + '</div>';
            bindSurveyPhotoDropzones();
        }

        function bindSurveyPhotoDropzones() {
            document.querySelectorAll('#surveyEditModalForm .file-upload-wrap').forEach(wrap => {
                const input = wrap.querySelector('.file-upload-input');
                const dropzone = wrap.querySelector('.file-upload-dropzone');
                dropzone.addEventListener('click', () => input.click());
                ['dragenter', 'dragover'].forEach(event => {
                    dropzone.addEventListener(event, (e) => {
                        e.preventDefault();
                        dropzone.classList.add('dragover');
                    });
                });
                ['dragleave', 'drop'].forEach(event => {
                    dropzone.addEventListener(event, (e) => {
                        e.preventDefault();
                        dropzone.classList.remove('dragover');
                    });
                });
                dropzone.addEventListener('drop', (e) => {
                    const files = e.dataTransfer.files;
                    if (files.length > 0) {
                        input.files = files;
                        handleSurveyPhotoUpload(input);
                    }
                });
            });
        }

        function handleSurveyPhotoUpload(input) {
            const wrap = input.parentElement;
            const idx = parseInt(wrap.dataset.idx, 10);
            const files = Array.from(input.files || []);
            if (files.length === 0) return;
            const proofIndex = getSurveyData()[surveyEditModalSubTab].columns.indexOf('上传证明文件');
            const photoIndex = getSurveyData()[surveyEditModalSubTab].columns.indexOf('排查照片');
