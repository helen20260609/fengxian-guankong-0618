        function saveRiskEdit() {
            const s = currentHouseArch;
            if (!s.riskInfo) s.riskInfo = {};
            if (!s.riskClassification) s.riskClassification = {};
            if (!Array.isArray(s.riskIdentification)) s.riskIdentification = [];
            const idx = Math.min(recordViewState.risk || 0, Math.max(s.riskIdentification.length - 1, 0));
            if (!s.riskIdentification[idx]) s.riskIdentification[idx] = {};
            const rec = s.riskIdentification[idx];
            document.querySelectorAll('#riskEditForm .risk-edit-input').forEach(function(input) {
                const field = input.dataset.field;
                const val = input.value;
                if (input.dataset.scope === 'info') {
                    s.riskInfo[field] = val;
                } else if (input.dataset.scope === 'cls') {
                    s.riskClassification[field] = val;
                } else {
                    rec[field] = val;
                }
            });
            delete s._syncedAt; // 编辑后标记为未同步
            saveCurrentHouseArch(s);
            closeRiskEditModal();
            renderSidebar();
            renderContent();
        }

