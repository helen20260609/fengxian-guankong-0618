                    const label = sel.closest('.form-item') && sel.closest('.form-item').querySelector('.form-label');
                    if (label && label.textContent === '房屋性质') curNature = sel.value;
                });
                rows = getJbxxRows(curNature);
            } else {
                rows = getBasicData()[editModalSubTab] || [];
            }
            const abnormalMarkOptions = ['正常', '非城房排查范围', '非管辖范围(土地性质不明)', '已拆除', '异常图斑', '需合并图斑'];
            const houseNatureOptions = ['住宅', '非住宅'];
            // 行政区划数据（镇→村列表），来自 js/urban-house-arch-data.js
            const TOWN_VILLAGES = (typeof FENGXIAN_TOWN_VILLAGES !== 'undefined') ? FENGXIAN_TOWN_VILLAGES : {};
            const townOptions = Object.keys(TOWN_VILLAGES);
            // 解析当前"所在区域"值：例如"奉贤区西渡街道" 或 "奉贤区南桥镇张翁庙村"
            function parseRegionValue(val) {
                const s = (val || '').replace(/^上海市/, '').replace(/^奉贤区/, '');
                let town = '', village = '';
                for (let i = 0; i < townOptions.length; i++) {
                    const t = townOptions[i];
                    if (s.indexOf(t) === 0) {
                        town = t;
                        const rest = s.substring(t.length);
                        if (rest) village = rest;
                        break;
                    }
                }
                if (!town && s) town = s; // 兜底：未匹配时整体作为镇
                return { district: '奉贤区', town: town, village: village };
            }
            // ===== 城镇自建房基本信息：各字段选项配置 =====
            const URBAN_FIELD_OPTS = {
                '是否有物业管理': ['是', '否'],
                '是否为自建房': ['是', '否'],
                '是否采用外墙外保温': ['是', '否'],
                '是否专业设计建造': ['是', '否'],
                '是否保护性建筑': ['否', '市优秀历史建筑', '全国重点文物保护单位', '市级文物保护单位', '区级文物保护单位', '区级文物保护点'],
                '是否取得施工许可': ['是', '否'],
                '房屋权属': ['商品房', '系统公房', '直管公房', '售后公房', '私房', '其他公房', '动迁安置房', '公租房或廉住房', '共有产权房', '其他'],
                '房屋类型': ['简屋', '里弄', '花园住宅', '联列住宅', '公寓', '职工住宅(新工房)'],
                '结构类型': ['砌体结构', '钢筋混凝土结构', '钢结构', '木结构', '其它'],
                '二级结构类型': ['底部框架-抗震墙结构砌体结构', '其他'],
                '外墙面类型': ['涂料', '马赛克', '面砖', '石材', '清水墙', '其他'],
                '建筑外立面附属构件': ['挑檐', '装饰构架', '装饰线条（GRC、EPS）', '栏杆', '无'],
                '土地性质': ['国有土地-居住用地', '国有土地-商住用地', '国有土地-商业用地', '国有土地-国有非建筑用地', '国有土地-其他', '集体土地'],
                // ===== 使用情况 tab 字段 =====
                '是否小梁薄板房屋': ['是', '否'],
                '是否用作生产经营': ['是', '否'],
                '是否改变使用用途': ['是', '否'],
                '是否人员聚集场所': ['是', '否'],
                '有无四有现象': ['有多次报修', '有抢险记录', '有投诉或反映', '有明显隐患'],
                '是否改造': ['是', '否', '改造1次', '改造2次及以上'],
                '是否采用减震隔震': ['是', '否'],
                '是否进行抗震加固': ['是', '否']
            };
            // 带单位的数字字段
            const URBAN_UNIT_FIELDS = {
                '地上建筑面积': 'm²', '地下建筑面积': 'm²',
                '地上建筑层数': '层', '地下建筑层数': '层',
                '建筑高度': 'm', '户数(户)': ''
            };
            // 多选字段（checkbox）
            const URBAN_CHECKBOX_FIELDS = ['外墙面类型', '建筑外立面附属构件', '有无四有现象'];
            // 独占一行字段
            const URBAN_FULL_WIDTH = ['路号信息', '土地性质', '房屋权属', '建筑外立面附属构件', '异常标记', '房屋类型',
                '结构类型', '二级结构类型', '是否专业设计建造', '是否保护性建筑', '是否取得施工许可', '外墙面类型',
                '有无四有现象', '是否改造'];
            // 月份选择字段
            const URBAN_MONTH_FIELDS = ['建造时间'];

            // 生成单选 radio HTML
            // extraAfterOption: { option: '某选项', html: '...' } — 在该选项 label 后插入附加 HTML（如"其他"输入框）
            function buildUrbanRadio(name, label, options, curVal, extraAfterOption) {
                return '<div class="urban-radio-group" style="display:flex;flex-wrap:wrap;gap:10px;align-items:center;">' +
                    options.map(function(o) {
                        const checked = (o === curVal) ? ' checked' : '';
                        let h = '<label style="display:inline-flex;align-items:center;gap:4px;cursor:pointer;font-size:13px;">' +
                            '<input type="radio" name="urban-radio-' + name + '" class="urban-radio" data-idx="' + name + '" value="' + o + '"' + checked + ' style="cursor:pointer;">' +
                            '<span>' + o + '</span>' +
                            '</label>';
                        if (extraAfterOption && o === extraAfterOption.option) {
                            h += extraAfterOption.html;
                        }
                        return h;
                    }).join('') +
                    '</div>';
            }
            // 生成 checkbox HTML
            function buildUrbanCheckbox(idx, options, curVal) {
                const curArr = (curVal || '').split(/[,，、]/).map(function(s) { return s.trim(); }).filter(Boolean);
                return '<div class="urban-checkbox-group" style="display:flex;flex-wrap:wrap;gap:10px;align-items:center;">' +
                    options.map(function(o) {
                        const checked = curArr.indexOf(o) !== -1 ? ' checked' : '';
                        return '<label style="display:inline-flex;align-items:center;gap:4px;cursor:pointer;font-size:13px;">' +
                            '<input type="checkbox" class="urban-checkbox" data-idx="' + idx + '" value="' + o + '"' + checked + ' style="cursor:pointer;">' +
                            '<span>' + o + '</span>' +
                            '</label>';
                    }).join('') +
                    '</div>';
            }

            const gridHtml = rows.map((r, idx) => {
                let inputHtml;
                const label = r[0];
                const curVal = (r[1] || '') + '';
                // 跳过辅助字段：房屋权属其他内容、土地性质其他内容、结构类型其他内容（不单独展示）
                if (label === '房屋权属其他内容' || label === '土地性质其他内容' || label === '结构类型其他内容') return '';
                if (label === '异常标记') {
                    inputHtml = buildUrbanRadio(idx, label, abnormalMarkOptions, curVal) +
                        '<input type="hidden" class="form-input urban-radio-hidden" data-idx="' + idx + '" value="' + curVal.replace(/"/g, '&quot;') + '">';
                } else if (label === '房屋性质') {
                    inputHtml = buildUrbanRadio(idx, label, houseNatureOptions, curVal) +
                        '<input type="hidden" class="form-input urban-radio-hidden" data-idx="' + idx + '" value="' + curVal.replace(/"/g, '&quot;') + '">';
                } else if (URBAN_FIELD_OPTS[label] && URBAN_CHECKBOX_FIELDS.indexOf(label) === -1) {
                    // 单选 radio（所有有选项的非 checkbox 字段）
                    let extraAfter = null;
                    // 土地性质"国有土地-其他"需要额外输入框（跟在选项后面）
                    if (label === '土地性质') {
                        const landOtherVal = libValLocal(rows, '土地性质其他内容') || '';
                        extraAfter = {
                            option: '国有土地-其他',
                            html: '<input class="form-input" type="text" data-extra-label="土地性质其他内容" placeholder="请输入其他土地使用用途" value="' + (landOtherVal || '').replace(/"/g, '&quot;') + '" style="width:200px;padding:4px 8px;font-size:12px;' + (curVal === '国有土地-其他' ? '' : 'display:none;') + '" id="landRightOtherInput">'
                        };
                    }
                    // 结构类型"其它"需要额外下拉框（跟在选项后面）
                    if (label === '结构类型') {
                        const structOtherVal = libValLocal(rows, '结构类型其他内容') || '';
                        const structOtherOptions = ['竹结构', '土结构', '石结构', '混合结构', '组合结构', '混杂结构', '其他'];
                        const structOtherOptsHtml = structOtherOptions.map(function(o) {
                            return '<option value="' + o + '"' + (o === structOtherVal ? ' selected' : '') + '>' + o + '</option>';
                        }).join('');
                        extraAfter = {
                            option: '其它',
                            html: '<select class="form-input" data-extra-label="结构类型其他内容" style="width:200px;padding:4px 8px;font-size:12px;' + (curVal === '其它' ? '' : 'display:none;') + '" id="structTypeOtherSelect">' +
                                '<option value="">请选择</option>' + structOtherOptsHtml +
                                '</select>'
                        };
                    }
                    inputHtml = buildUrbanRadio(idx, label, URBAN_FIELD_OPTS[label], curVal, extraAfter) +
                        '<input type="hidden" class="form-input urban-radio-hidden" data-idx="' + idx + '" value="' + curVal.replace(/"/g, '&quot;') + '">';
                    // 房屋权属"其他"需要额外输入框
                    if (label === '房屋权属') {
                        const otherVal = libValLocal(rows, '房屋权属其他内容') || '';
                        inputHtml += '<input class="form-input" type="text" data-extra-label="房屋权属其他内容" placeholder="请输入其他内容" value="' + (otherVal || '').replace(/"/g, '&quot;') + '" style="margin-top:6px;' + (curVal === '其他' ? '' : 'display:none;') + '" id="houseRightOtherInput">';
                    }
                } else if (URBAN_CHECKBOX_FIELDS.indexOf(label) !== -1) {
                    // 多选 checkbox
                    inputHtml = buildUrbanCheckbox(idx, URBAN_FIELD_OPTS[label], curVal) +
                        '<input type="hidden" class="form-input urban-checkbox-hidden" data-idx="' + idx + '" value="' + curVal.replace(/"/g, '&quot;') + '">';
                } else if (URBAN_MONTH_FIELDS.indexOf(label) !== -1) {
                    // 月份选择
                    inputHtml = '<input class="form-input" type="month" data-idx="' + idx + '" value="' + curVal.replace(/"/g, '&quot;') + '">';
                } else if (URBAN_UNIT_FIELDS[label] !== undefined && URBAN_UNIT_FIELDS[label] !== '') {
                    // 带单位输入
                    inputHtml = '<div style="display:flex;align-items:center;gap:6px;">' +
                        '<input class="form-input" type="number" data-idx="' + idx + '" value="' + curVal.replace(/"/g, '&quot;') + '" style="flex:1;">' +
                        '<span style="color:#595959;font-size:13px;white-space:nowrap;">' + URBAN_UNIT_FIELDS[label] + '</span>' +
                        '</div>';
                } else if (label === '所在区域') {
                    // 三级联动：区(固定奉贤区) + 镇/街道 + 村/居委
                    const parsed = parseRegionValue(curVal);
                    const townOpts = ['<option value="">请选择镇/街道</option>'].concat(
                        townOptions.map(t => '<option value="' + t + '"' + (t === parsed.town ? ' selected' : '') + '>' + t + '</option>')
                    ).join('');
                    const villageList = (parsed.town && TOWN_VILLAGES[parsed.town]) ? TOWN_VILLAGES[parsed.town] : [];
                    const villageOpts = ['<option value="">请选择村/居委</option>'].concat(
                        villageList.map(v => '<option value="' + v + '"' + (v === parsed.village ? ' selected' : '') + '>' + v + '</option>')
                    ).join('');
                    inputHtml =
                        '<div style="display:flex;gap:6px;align-items:center;">' +
                        '<input type="hidden" class="form-input region-hidden" data-idx="' + idx + '" value="' + curVal.replace(/"/g, '&quot;') + '">' +
                        '<select class="form-input-inline region-district" data-region-part="district" data-idx="' + idx + '" disabled style="flex:1;padding:6px 8px;border:1px solid #d9d9d9;border-radius:4px;background:#f5f5f5;">' +
                            '<option value="奉贤区" selected>奉贤区</option>' +
                        '</select>' +
                        '<select class="form-input-inline region-town" data-region-part="town" data-idx="' + idx + '" style="flex:1;padding:6px 8px;border:1px solid #d9d9d9;border-radius:4px;">' + townOpts + '</select>' +
                        '<select class="form-input-inline region-village" data-region-part="village" data-idx="' + idx + '" style="flex:1;padding:6px 8px;border:1px solid #d9d9d9;border-radius:4px;">' + villageOpts + '</select>' +
                        '</div>';
                } else if (label === '路号信息') {
                    // 分段：路名 + 号 + 栋，独占一行，支持多地址
                    const fullVal = curVal;
                    const addrParts = fullVal.split(/[;；]/).map(s => s.trim()).filter(s => s);
                    const mainAddr = addrParts[0] || '';
                    const extraAddrs = addrParts.slice(1);
                    function parseAddr(s) {
                        let roadName = '', haoPart = '', dongPart = '';
                        const m1 = (s || '').match(/^(.+?(?:路|街|道|巷|弄))(.*)$/);
                        if (m1) {
                            roadName = m1[1];
                            const rest = m1[2] || '';
                            const m2 = rest.match(/^(\d+(?:号|室)?)?(.*)$/);
                            if (m2) {
                                haoPart = (m2[1] || '').replace(/号$/, '');
                                dongPart = m2[2] || '';
                            }
                        } else {
                            roadName = s || '';
                        }
                        return { roadName: roadName, haoPart: haoPart, dongPart: dongPart };
                    }
                    const inputStyle = 'padding:6px 8px;border:1px solid #d9d9d9;border-radius:4px;font-size:13px;';
                    function buildAddrRow(subIdx, addrObj, isMain) {
                        const rn = (addrObj.roadName || '').replace(/"/g, '&quot;');
                        const hp = (addrObj.haoPart || '').replace(/"/g, '&quot;');
                        const dp = (addrObj.dongPart || '').replace(/"/g, '&quot;');
                        let html =
                            '<div class="road-addr-row" data-idx="' + idx + '" data-sub-idx="' + subIdx + '" style="display:flex;gap:4px;align-items:center;flex-wrap:nowrap;margin-bottom:6px;">' +
                            '<div style="position:relative;flex:2;min-width:140px;">' +
                                '<input type="text" class="form-input-inline road-name" data-idx="' + idx + '" data-sub-idx="' + subIdx + '" placeholder="路名" value="' + rn + '" style="width:100%;' + inputStyle + 'padding-right:26px;">' +
                                '<i class="fas fa-search road-search-icon" data-idx="' + idx + '" data-sub-idx="' + subIdx + '" style="position:absolute;right:8px;top:50%;transform:translateY(-50%);color:#bfbfbf;font-size:12px;cursor:pointer;" title="搜索已有地址"></i>' +
                            '</div>' +
                            '<span style="color:#595959;font-size:12px;white-space:nowrap;padding:0 2px;">路(街道/巷)</span>' +
                            '<input type="text" class="form-input-inline road-hao" data-idx="' + idx + '" data-sub-idx="' + subIdx + '" placeholder="100" value="' + hp + '" style="flex:1;min-width:70px;' + inputStyle + '">' +
                            '<span style="color:#595959;font-size:12px;white-space:nowrap;padding:0 2px;">号(弄)</span>' +
                            '<input type="text" class="form-input-inline road-dong" data-idx="' + idx + '" data-sub-idx="' + subIdx + '" placeholder="" value="' + dp + '" style="flex:1;min-width:70px;' + inputStyle + '">' +
                            '<span style="color:#595959;font-size:12px;white-space:nowrap;padding:0 2px;">栋(单元/号)</span>';
                        if (isMain) {
                            html += '<a href="javascript:void(0)" class="road-add-multi" data-idx="' + idx + '" style="color:#1890ff;font-size:12px;white-space:nowrap;text-decoration:none;display:inline-flex;align-items:center;gap:2px;padding:0 4px;" title="添加多地址">' +
                                '<i class="fas fa-plus-circle"></i> 添加多地址' +
                            '</a>';
                        } else {
                            html += '<a href="javascript:void(0)" class="road-remove-multi" data-idx="' + idx + '" data-sub-idx="' + subIdx + '" style="color:#ff4d4f;font-size:12px;white-space:nowrap;text-decoration:none;display:inline-flex;align-items:center;gap:2px;padding:0 4px;" title="删除该地址">' +
                                '<i class="fas fa-minus-circle"></i> 删除' +
                            '</a>';
                        }
                        html += '</div>';
                        return html;
                    }
                    let rowsHtml = buildAddrRow(0, parseAddr(mainAddr), true);
                    extraAddrs.forEach(function(addr, i) {
                        rowsHtml += buildAddrRow(i + 1, parseAddr(addr), false);
                    });
                    inputHtml =
                        '<div class="road-addr-container" data-idx="' + idx + '" style="width:100%;position:relative;">' +
                        '<input type="hidden" class="form-input road-hidden" data-idx="' + idx + '" value="' + fullVal.replace(/"/g, '&quot;') + '">' +
                        '<div class="road-addr-list" data-idx="' + idx + '">' + rowsHtml + '</div>' +
                        '<div class="road-search-panel" data-idx="' + idx + '" style="display:none;position:absolute;top:100%;left:0;right:0;background:#fff;border:1px solid #d9d9d9;border-radius:4px;box-shadow:0 2px 8px rgba(0,0,0,0.15);z-index:1000;max-height:300px;overflow-y:auto;margin-top:4px;">' +
                            '<div class="road-search-panel-header" style="display:flex;padding:8px 12px;border-bottom:1px solid #f0f0f0;background:#fafafa;font-size:12px;color:#595959;font-weight:500;">' +
                                '<div style="flex:2;">路(街道/巷)</div>' +
                                '<div style="flex:1;">号(弄)</div>' +
                                '<div style="flex:1;">栋(单元/号)</div>' +
                            '</div>' +
                            '<div class="road-search-panel-body" data-idx="' + idx + '"></div>' +
                        '</div>' +
                        '</div>';
                } else {
                    inputHtml = '<input class="form-input" type="text" data-idx="' + idx + '" value="' + curVal.replace(/"/g, '&quot;') + '">';
                }
                // 独占一行字段
                const isFullWidth = (label === '路号信息') || URBAN_FULL_WIDTH.indexOf(label) !== -1;
                const itemClass = isFullWidth ? 'form-item form-item-full' : 'form-item';
                return '<div class="' + itemClass + '">' +
                    '<label class="form-label">' + label + '</label>' +
                    inputHtml +
                    '</div>';
            }).join('');
            document.getElementById('editModalForm').innerHTML = '<div class="form-grid">' + gridHtml + '</div>';

            // 绑定镇→村联动
            document.querySelectorAll('#editModalForm .region-town').forEach(function(townSel) {
                townSel.addEventListener('change', function() {
                    const idx = this.dataset.idx;
                    const villageSel = document.querySelector('#editModalForm .region-village[data-idx="' + idx + '"]');
                    const hiddenInput = document.querySelector('#editModalForm .region-hidden[data-idx="' + idx + '"]');
                    if (!villageSel) return;
                    const town = this.value;
                    villageSel.innerHTML = '<option value="">请选择村/居委</option>';
                    if (town && TOWN_VILLAGES[town]) {
                        TOWN_VILLAGES[town].forEach(function(v) {
                            const opt = document.createElement('option');
                            opt.value = v; opt.textContent = v;
                            villageSel.appendChild(opt);
                        });
                    }
                    // 更新隐藏字段值
                    if (hiddenInput) {
                        hiddenInput.value = '奉贤区' + town + (villageSel.value || '');
                    }
                });
            });
            document.querySelectorAll('#editModalForm .region-village').forEach(function(villageSel) {
                villageSel.addEventListener('change', function() {
                    const idx = this.dataset.idx;
                    const townSel = document.querySelector('#editModalForm .region-town[data-idx="' + idx + '"]');
                    const hiddenInput = document.querySelector('#editModalForm .region-hidden[data-idx="' + idx + '"]');
                    if (hiddenInput && townSel) {
                        hiddenInput.value = '奉贤区' + (townSel.value || '') + (this.value || '');
                    }
                });
            });

            // 路号信息分段输入：实时合并多行地址到隐藏域（用 ; 分隔）
            function updateRoadHidden(idx) {
                const hiddenInput = document.querySelector('#editModalForm .road-hidden[data-idx="' + idx + '"]');
                if (!hiddenInput) return;
                const rows = document.querySelectorAll('#editModalForm .road-addr-row[data-idx="' + idx + '"]');
                const addrList = [];
                rows.forEach(function(row) {
                    const subIdx = row.dataset.subIdx;
                    const roadName = (row.querySelector('.road-name') || {}).value || '';
                    const haoPart = (row.querySelector('.road-hao') || {}).value || '';
                    const dongPart = (row.querySelector('.road-dong') || {}).value || '';
                    if (!roadName && !haoPart && !dongPart) return; // 跳过空行
                    let combined = roadName;
                    if (haoPart) combined += haoPart + '号';
                    if (dongPart) combined += dongPart;
                    addrList.push(combined);
                });
                hiddenInput.value = addrList.join(';');
            }
            // 给指定容器内所有路号输入绑定 input 事件
            function bindRoadInputs(container) {
                container.querySelectorAll('.road-name, .road-hao, .road-dong').forEach(function(inp) {
                    inp.addEventListener('input', function() { updateRoadHidden(this.dataset.idx); });
                });
            }
            bindRoadInputs(document.getElementById('editModalForm'));

            // 路号信息：搜索面板（点击搜索图标显示已有地址列表，点击行回填）
            (function bindRoadSearchPanel() {
                const addrList = getAllHouseAddrList();
                // 渲染面板内容
                function renderPanel(panelBody, filterText) {
                    const filtered = filterText ? addrList.filter(function(item) {
                        return item.road.indexOf(filterText) !== -1 || item.hao.indexOf(filterText) !== -1 || item.dong.indexOf(filterText) !== -1;
                    }) : addrList;
                    panelBody.innerHTML = filtered.map(function(item) {
                        return '<div class="road-search-panel-row" data-road="' + (item.road || '').replace(/"/g, '&quot;') + '" data-hao="' + (item.hao || '').replace(/"/g, '&quot;') + '" data-dong="' + (item.dong || '').replace(/"/g, '&quot;') + '" style="display:flex;padding:8px 12px;border-bottom:1px solid #f5f5f5;cursor:pointer;font-size:13px;color:#202124;" onmouseover="this.style.background=\'#f5f5f5\'" onmouseout="this.style.background=\'\'">' +
                            '<div style="flex:2;">' + (item.road || '') + '</div>' +
                            '<div style="flex:1;">' + (item.hao || '') + '</div>' +
                            '<div style="flex:1;">' + (item.dong || '') + '</div>' +
                            '</div>';
                    }).join('');
