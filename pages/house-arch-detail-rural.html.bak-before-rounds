        function saveCloseBatchAudit() {
            const s = currentHouseArch;
            const records = getCloseHistoryRecords(s);
            const idxs = (closeBatchAuditSelection || []).filter(i => records[i]);
            if (!idxs.length) { closeCloseBatchAuditModal(); return; }
            const auditor = ((document.getElementById('cba-auditor') || {}).value || '').trim() || '王建国';
            const conclusion = (document.getElementById('cba-conclusion') || {}).value || '审核通过';
            const remark = ((document.getElementById('cba-remark') || {}).value || '').trim();
            const now = new Date();
            const pad = n => String(n).padStart(2, '0');
            const ts = now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate()) + ' ' + pad(now.getHours()) + ':' + pad(now.getMinutes()) + ':' + pad(now.getSeconds());
            const names = [];
            const reporters = [];
            idxs.forEach(function(i) {
                records[i].audited = true;
                records[i].auditConclusion = conclusion;
                records[i].auditTime = ts;
                records[i].auditor = auditor;
                names.push('第' + (i + 1) + '条 ' + (records[i].projectName || records[i].closeMethod || '填报内容'));
                const rp = records[i].reporter;
                if (rp && reporters.indexOf(rp) < 0) reporters.push(rp);
            });
            const list = buildCloseAuditList().slice();
            list.push({
                submitter: reporters.join('、') || (s.responsiblePerson || s.owner || ''),
                submitTime: idxs.map(i => records[i].reportTime || '').filter(Boolean).sort().pop() || ts,
                auditTime: ts,
                auditor: auditor,
                conclusion: conclusion,
                report: '',
                remark: remark,
                recordIndexes: idxs.slice(),
                recordNames: names
            });
            s.closeAuditRecords = list;
            saveCurrentHouseArch(s);
            closeBatchAuditSelection = [];
            closeCloseBatchAuditModal();
            renderContent();
            alert('批量审核完成：已对 ' + idxs.length + ' 条填报内容生成一条审核记录。');
