                        '<div style="position:relative;flex:2;min-width:140px;">' +
                            '<input type="text" class="form-input-inline road-name" data-idx="' + idx + '" data-sub-idx="' + newSubIdx + '" placeholder="路名" value="" style="width:100%;' + inputStyle + 'padding-right:26px;">' +
                            '<i class="fas fa-search" style="position:absolute;right:8px;top:50%;transform:translateY(-50%);color:#bfbfbf;font-size:12px;pointer-events:none;"></i>' +
                        '</div>' +
                        '<span style="color:#595959;font-size:12px;white-space:nowrap;padding:0 2px;">路(街道/巷)</span>' +
                        '<input type="text" class="form-input-inline road-hao" data-idx="' + idx + '" data-sub-idx="' + newSubIdx + '" placeholder="100" value="" style="flex:1;min-width:70px;' + inputStyle + '">' +
                        '<span style="color:#595959;font-size:12px;white-space:nowrap;padding:0 2px;">号(弄)</span>' +
                        '<input type="text" class="form-input-inline road-dong" data-idx="' + idx + '" data-sub-idx="' + newSubIdx + '" placeholder="" value="" style="flex:1;min-width:70px;' + inputStyle + '">' +
                        '<span style="color:#595959;font-size:12px;white-space:nowrap;padding:0 2px;">栋(单元/号)</span>' +
                        '<a href="javascript:void(0)" class="road-remove-multi" data-idx="' + idx + '" data-sub-idx="' + newSubIdx + '" style="color:#ff4d4f;font-size:12px;white-space:nowrap;text-decoration:none;display:inline-flex;align-items:center;gap:2px;padding:0 4px;" title="删除该地址">' +
