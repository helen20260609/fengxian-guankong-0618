                        panel.style.display = 'none';
                        return;
                    }
                    // 点击面板外部关闭
                    if (!e.target.closest('.road-search-panel') && !e.target.closest('.road-search-icon')) {
                        document.querySelectorAll('#editModalForm .road-search-panel').forEach(function(p) { p.style.display = 'none'; });
                    }
