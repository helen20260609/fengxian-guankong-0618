                vals[el.getAttribute('data-close-' + scope + '-field')] = el.value;
            });
            const toArr = (v) => String(v || '').split(',').map(t => t.trim()).filter(Boolean);
            let rec;
            if (editIdx >= 0 && list[editIdx]) {
                rec = list[editIdx];
