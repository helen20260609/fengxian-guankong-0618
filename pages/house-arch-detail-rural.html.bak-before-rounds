        function getAllHouseAddrList() {
            try {
                const raw = localStorage.getItem('urbanHouseArchData');
                if (!raw) return [];
                const data = JSON.parse(raw);
                const houses = Object.values(data);
                const list = [];
                const seen = new Set();
                houses.forEach(function(h) {
                    const addr = (h.address || '').trim();
                    if (!addr) return;
                    // 解析 "上海市奉贤区南桥镇张翁庙村3号" → road="奉贤区南桥镇张翁庙村", hao="3", dong=""
                    let s = addr.replace(/^上海市/, '').replace(/^奉贤区/, '奉贤区');
                    // 尝试提取 号
                    const m = s.match(/^(.+?)(\d+(?:号|室))?$/);
                    let road = s, hao = '', dong = '';
                    if (m) {
                        road = m[1] || s;
                        hao = (m[2] || '').replace(/号$/, '');
                    }
                    // 尝试从 road 里提取 幢/栋
                    const m2 = road.match(/^(.+?)(\d+幢|\d+栋)(.*)$/);
                    if (m2) {
                        road = m2[1] + (m2[3] || '');
                        dong = m2[2];
                    }
                    const key = road + '|' + hao + '|' + dong;
                    if (seen.has(key)) return;
                    seen.add(key);
                    list.push({ road: road, hao: hao, dong: dong });
                });
                return list;
