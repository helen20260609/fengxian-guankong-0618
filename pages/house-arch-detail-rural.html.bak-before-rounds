                        '<input class="file-upload-input" type="file" accept="image/*" multiple data-idx="' + origIdx + '" onchange="handleCommonPhotoUpload(this)">' +
                        '<div class="file-upload-dropzone"><i class="fas fa-cloud-upload-alt"></i> 点击或拖拽上传图片</div>' +
                        thumbHtml +
                        '</div>';
                    fullWidth = 'form-item-full';
                } else if (key === 'assessment' && c === '鉴定报告') {
                    // 鉴定报告：附件上传，支持图片/PDF/Word/Excel/CAD/ZIP/RAR
                    const val = rows[origIdx] || '';
                    const files = projectFilesFromString(val);
                    inputHtml = '<div class="file-upload-wrap" data-idx="' + origIdx + '" data-attach-field="assessment-report">' +
                        '<input class="form-input file-url-input" type="text" data-idx="' + origIdx + '" value="' + projectFilesToString(files).replace(/"/g, '&quot;') + '" placeholder="文件 URL 或将文件拖入下方">' +
                        '<input class="file-upload-input" type="file" multiple data-idx="' + origIdx + '" onchange="handleCommonFileUpload(this)">' +
                        '<div class="file-upload-dropzone"><i class="fas fa-cloud-upload-alt"></i> 点击或拖拽上传文件（支持图片、PDF、Word、Excel、CAD、ZIP、RAR）</div>' +
                        '<div class="project-file-list"></div>' +
                        '</div>';
                    fullWidth = 'form-item-full';
                } else {
                    inputHtml = '<input class="form-input" type="text" data-idx="' + origIdx + '" value="' + (rows[origIdx] || '').replace(/"/g, '&quot;') + '">';
                }
                return '<div class="form-item ' + fullWidth + '">' +
                    '<label class="form-label">' + c + '</label>' +
                    inputHtml +
                    '</div>';
            }).join('');
            let auditHtml = '';
            if (key === 'accept' || key === 'close') {
                auditHtml = renderCommonEditAuditList(data.auditList, key === 'accept');
            }
            document.getElementById('commonEditForm').innerHTML = '<div class="form-grid">' + gridHtml + '</div>' + auditHtml;
            bindCommonPhotoDropzones();
            document.getElementById('commonEditModal').classList.add('open');
        }

        function bindCommonPhotoDropzones() {
            document.querySelectorAll('#commonEditForm .file-upload-wrap').forEach(wrap => {
                const input = wrap.querySelector('.file-upload-input');
                const dropzone = wrap.querySelector('.file-upload-dropzone');
                const isAttach = wrap.dataset.attachField === 'assessment-report';
                const uploadFn = isAttach ? handleCommonFileUpload : handleCommonPhotoUpload;
                dropzone.addEventListener('click', () => input.click());
                ['dragenter', 'dragover'].forEach(event => {
                    dropzone.addEventListener(event, (e) => {
                        e.preventDefault();
                        dropzone.classList.add('dragover');
                    });
                });
                ['dragleave', 'drop'].forEach(event => {
                    dropzone.addEventListener(event, (e) => {
                        e.preventDefault();
                        dropzone.classList.remove('dragover');
                    });
                });
                dropzone.addEventListener('drop', (e) => {
                    const files = e.dataTransfer.files;
                    if (files.length > 0) {
                        input.files = files;
                        uploadFn(input);
                    }
                });
                // 初始渲染附件列表
                if (isAttach) {
                    const urlInput = wrap.querySelector('.file-url-input');
                    const files = projectFilesFromString(urlInput.value || '');
                    renderCommonFileList(wrap, files);
                }
            });
        }

        function handleCommonPhotoUpload(input) {
            const wrap = input.parentElement;
            const files = Array.from(input.files || []);
            if (files.length === 0) return;
            const invalid = files.find(f => !f.type.startsWith('image/'));
            if (invalid) {
                alert('请上传图片文件');
                return;
            }
            const urlInput = wrap.querySelector('.file-url-input');
            const existingUrls = urlInput.value.split(',').map(s => s.trim()).filter(Boolean);
            const readers = files.map(file => {
                return new Promise(resolve => {
                    const reader = new FileReader();
                    reader.onload = e => resolve(e.target.result);
                    reader.readAsDataURL(file);
                });
            });
            Promise.all(readers).then(results => {
                const allUrls = existingUrls.concat(results).filter((v, i, a) => a.indexOf(v) === i);
                urlInput.value = allUrls.join(',');
                urlInput.dispatchEvent(new Event('input'));
                renderCommonPhotoThumbs(wrap, allUrls);
            });
        }

        function renderCommonPhotoThumbs(wrap, urls) {
            let thumb = wrap.querySelector('.file-thumb-preview');
            if (!thumb) {
                thumb = document.createElement('div');
                thumb.className = 'file-thumb-preview';
                wrap.appendChild(thumb);
            }
            thumb.innerHTML = urls.filter(u => u && u !== '—' && u !== '-').map(u => '<img src="' + u + '" alt="预览" onclick="viewPhotoOnline(\'' + u + '\')">').join('');
        }

        // 通用附件上传（用于"鉴定报告"等字段，支持图片/PDF/Word/Excel/CAD/ZIP/RAR）
        async function handleCommonFileUpload(input) {
            const files = Array.from(input.files || []);
            if (files.length === 0) return;
            const { valid, invalid } = validateFiles(files, false);
            if (invalid.length > 0) {
                alert('以下文件格式不允许：\n' + invalid.join('\n') + '\n\n允许上传：图片、PDF、Word、Excel、CAD、ZIP、RAR 等文件。');
                return;
            }
            const wrap = input.closest('.file-upload-wrap');
            const urlInput = wrap.querySelector('.file-url-input');
            const current = projectFilesFromString(urlInput.value || '');
            const newFiles = [];
            for (const file of valid) {
                if (file.type.startsWith('image/')) {
                    try {
                        const url = await fileToDataUrl(file);
                        newFiles.push({ name: file.name, url: url, type: file.type, size: formatFileSize(file.size), uploadTime: formatDateTime(new Date()) });
                    } catch (e) { /* ignore */ }
                } else {
                    // 非图片文件仅存文件名，避免 dataURL 撑爆 localStorage
                    newFiles.push({ name: file.name, url: file.name, type: file.type, size: formatFileSize(file.size), uploadTime: formatDateTime(new Date()) });
                }
            }
            const all = current.concat(newFiles);
            urlInput.value = projectFilesToString(all);
            urlInput.dispatchEvent(new Event('input'));
            renderCommonFileList(wrap, all);
        }

        function renderCommonFileList(wrap, files) {
            let list = wrap.querySelector('.project-file-list');
            if (!list) {
                list = document.createElement('div');
                list.className = 'project-file-list';
                wrap.appendChild(list);
            }
            if (!files || files.length === 0) {
                list.innerHTML = '';
                return;
            }
            list.innerHTML = '<div style="font-size:12px;color:var(--text-secondary);margin-bottom:6px;">已上传 ' + files.length + ' 个附件</div>' + files.map((f, idx) => {
                const isImage = f.url && (f.url.startsWith('data:image') || f.url.startsWith('http') && /\.(jpg|jpeg|png|gif|bmp|webp)$/i.test(f.url));
                const icon = isImage ? 'fa-image' : 'fa-file';
                const preview = isImage ? ' onclick="viewPhotoOnline(\'' + f.url + '\')" style="cursor:pointer;color:var(--primary);"' : ' style="color:var(--text-secondary);"';
                return '<div class="project-file-item">' +
                    '<i class="fas ' + icon + '"></i> ' +
                    '<span' + preview + '>' + (f.name || '附件') + ' <span style="color:#999;">(' + (f.size || '-') + ')</span></span>' +
                    '<button type="button" class="project-file-remove" onclick="removeCommonFile(this, ' + idx + ')" title="删除"><i class="fas fa-times"></i></button>' +
                    '</div>';
            }).join('');
        }

