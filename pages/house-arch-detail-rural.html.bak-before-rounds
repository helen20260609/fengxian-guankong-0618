        // 上传：读文件为 base64，追加到 hidden input，重新渲染当前表单
        function handleSafeStatusPhotoUpload(input) {
            const files = Array.from(input.files || []);
            if (!files.length) return;
            const idx = input.dataset.idx;
            const hidden = document.querySelector('#editModalForm .safe-photo-hidden[data-idx="' + idx + '"]');
            if (!hidden) return;
            let pending = files.length;
            const newUrls = [];
            files.forEach(function(f) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    newUrls.push(e.target.result);
                    pending--;
                    if (pending === 0) {
                        const cur = (hidden.value || '').split('\n').map(s => s.trim()).filter(Boolean);
                        const merged = cur.concat(newUrls);
                        const joined = merged.join('\n');
                        hidden.value = joined;
                        // 同步到数据源，避免 renderSafeStatusEditForm 重渲染时回滚
                        try {
                            const rows = getBasicData().safeStatus;
                            if (Array.isArray(rows) && rows[idx]) rows[idx][1] = joined;
                        } catch (e) {}
                        renderSafeStatusEditForm(); // 重新渲染以刷新缩略图
                    }
                };
                reader.readAsDataURL(f);
            });
        }

        // 删除：从 hidden input 中移除对应索引的 URL
        function handleSafeStatusPhotoRemove(btn) {
            const idx = btn.dataset.idx;
            const photoIdx = parseInt(btn.dataset.photoIdx, 10);
            const hidden = document.querySelector('#editModalForm .safe-photo-hidden[data-idx="' + idx + '"]');
            if (!hidden) return;
            const urls = (hidden.value || '').split('\n').map(s => s.trim()).filter(Boolean);
            if (photoIdx >= 0 && photoIdx < urls.length) {
                urls.splice(photoIdx, 1);
                const joined = urls.join('\n');
                hidden.value = joined;
                // 同步到数据源，避免 renderSafeStatusEditForm 重渲染时回滚
                try {
                    const rows = getBasicData().safeStatus;
                    if (Array.isArray(rows) && rows[idx]) rows[idx][1] = joined;
                } catch (e) {}
            }
            renderSafeStatusEditForm();
        }

