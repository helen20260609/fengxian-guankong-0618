                const defaultCenter = [30.920, 121.500];
                locationMap = L.map('locationMap').setView(defaultCenter, 13);
                L.tileLayer('https://map.geoq.cn/arcgis/rest/services/ChinaOnlineStreetPurplishBlue/MapServer/tile/{z}/{y}/{x}', { attribution: '© GeoQ', maxZoom: 18 }).addTo(locationMap);
                locationMap.on('click', function(e) {
                    setLocationMapMarker(e.latlng.lat, e.latlng.lng);
                });
            });
        }

        function setLocationMapMarker(lat, lng) {
            if (!locationMap) return;
            document.getElementById('mapPickerLat').value = lat.toFixed(6);
            document.getElementById('mapPickerLng').value = lng.toFixed(6);
            if (locationMapMarker) locationMap.removeLayer(locationMapMarker);
            locationMapMarker = L.marker([lat, lng]).addTo(locationMap);
            locationMap.setView([lat, lng], locationMap.getZoom() || 16);
        }

