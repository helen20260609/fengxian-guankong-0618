        .info-grid-2col .info-item.full-width { grid-column: 1 / -1; }
        .info-grid-2col .info-label { width: 140px; flex-shrink: 0; color: var(--text-secondary); font-size: 13px; }
        .info-grid-2col .info-value { flex: 1; min-width: 0; font-size: 14px; color: var(--text-primary); font-weight: 500; }
        .info-grid-table .info-item { flex-direction: row; align-items: flex-start; gap: 12px; }
        .info-grid-table .info-item.full-width { grid-column: 1 / -1; }
