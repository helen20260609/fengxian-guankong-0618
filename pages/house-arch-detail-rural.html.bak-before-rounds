        function handleCloseHistoryUpload(input) {
            const wrap = input.parentElement;
            const files = Array.from(input.files || []);
            if (!files.length) return;
            const urlInput = wrap.querySelector('.file-url-input');
            const readers = files.map(file => new Promise(resolve => {
                const r = new FileReader();
                r.onload = e => resolve(e.target.result);
                r.readAsDataURL(file);
            }));
            Promise.all(readers).then(urls => {
                const cur = urlInput.value ? urlInput.value.split(',').map(s => s.trim()).filter(Boolean) : [];
                urlInput.value = cur.concat(urls).join(',');
            });
        }

        function saveCloseHistoryForm(editIdx) {
