        function handleAddDangerPhotoUpload(input) {
            const files = Array.from(input.files || []);
            if (!files.length) return;
            const type = input.dataset.type;
            if (!type) return;
            const ad = getAddDanger();
            // 同步排查判断（防止重渲染丢失）
            const judgeSel = document.getElementById('addDangerJudge');
            if (judgeSel) ad.judge = judgeSel.value;
            const current = getAddDangerPhotos(type);
            let pending = files.length;
            files.forEach(f => {
                const reader = new FileReader();
                reader.onload = (ev) => {
                    current.push(ev.target.result);
                    pending--;
                    if (pending === 0) {
                        setAddDangerPhotos(type, current);
                        renderAddDangerEditForm();
                    }
                };
                reader.readAsDataURL(f);
            });
        }

        function handleAddDangerPhotoRemove(type, idx) {
            const ad = getAddDanger();
            // 同步排查判断（防止重渲染丢失）
            const judgeSel = document.getElementById('addDangerJudge');
            if (judgeSel) ad.judge = judgeSel.value;
            const current = getAddDangerPhotos(type);
            if (idx >= 0 && idx < current.length) {
                current.splice(idx, 1);
