            background: #fff; color: var(--text-primary); transition: all 0.2s;
        }
        .bottom-btn:hover { background: var(--bg-hover); }
        .bottom-btn.primary { background: var(--primary); color: #fff; border-color: var(--primary); }
        .bottom-btn.primary:hover { background: var(--primary-dark); }
        /* 只读模式：隐藏所有编辑入口（编辑/新增/删除/变更/审批/同步） */
        body.readonly-mode .bottom-actions { display: none !important; }
        body.readonly-mode .table-actions,
        body.readonly-mode .row-actions { display: none !important; }
        /* 操作单元格（配合 JS 隐藏对应表头） */
        body.readonly-mode td.actions { display: none !important; }
        body.readonly-mode th.col-action { display: none !important; }
