        // 保存表单
        function saveMeasureForm(kind, editIdx) {
            const s = currentHouseArch;
            const isManage = kind === 'manage';
            if (isManage && !Array.isArray(s.manageRecords)) s.manageRecords = [];
            if (!isManage && !Array.isArray(s.projectRecords)) s.projectRecords = [];
            const list = isManage ? s.manageRecords : s.projectRecords;
            const scope = (editIdx >= 0) ? 'edit' : 'new';
            // 收集字段
            const vals = {};
            document.querySelectorAll('[data-' + scope + '-field]').forEach(function(el) {
                vals[el.getAttribute('data-' + scope + '-field')] = el.value;
            });
            let rec;
            if (editIdx >= 0 && list[editIdx]) {
                rec = list[editIdx];
            } else {
                rec = {};
                const now = new Date();
                const pad = n => String(n).padStart(2, '0');
                const ts = now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate()) + ' ' + pad(now.getHours()) + ':' + pad(now.getMinutes());
                rec.reportTime = ts;
                rec.reporter = (s.responsiblePerson || s.owner || '').toString();
                if (isManage) {
                    rec.id = 'MGR-' + (s.no || 'X') + '-' + String(list.length + 1).padStart(3, '0');
                } else {
                    rec.id = 'PRJ-' + (s.no || 'X') + '-' + String(list.length + 1).padStart(3, '0');
                }
            }
            if (isManage) {
                rec.measureDesc = vals['measureDesc'] || '';
                rec.startTime = vals['startTime'] || '';
                rec.actualEndTime = vals['actualEndTime'] || '';
                rec.dutyPerson = vals['dutyPerson'] || '';
                rec.phone = vals['phone'] || '';
                rec.implementPhotos = vals['implementPhotos'] || '';
                rec.completePhotos = vals['completePhotos'] || '';
                rec.isDone = (vals['isDone'] === '已完成');
                rec.remark = vals['remark'] || '';
                rec.reporter = vals['reporter'] || rec.reporter || '';
                rec.reportTime = vals['reportTime'] || rec.reportTime || '';
            } else {
                rec.projectName = vals['projectName'] || '';
                rec.policyPath = vals['policyPath'] || '';
                rec.otherPolicyPath = vals['otherPolicyPath'] || '';
                rec.planDetail = vals['planDetail'] || '';
                rec.planFiles = (vals['planFiles'] || '').split(',').map(t => t.trim()).filter(Boolean);
                rec.startDate = vals['startDate'] || '';
                rec.endDate = vals['endDate'] || '';
                rec.manager = vals['manager'] || '';
                rec.phone = vals['phone'] || '';
                rec.implementPhotos = (vals['implementPhotos'] || '').split(',').map(t => t.trim()).filter(Boolean);
                rec.completePhotos = (vals['completePhotos'] || '').split(',').map(t => t.trim()).filter(Boolean);
                rec.status = vals['status'] || '进行中';
                rec.remark = vals['remark'] || '';
                rec.reporter = vals['reporter'] || rec.reporter || '';
                rec.reportTime = vals['reportTime'] || rec.reportTime || '';
            }
            if (editIdx >= 0) {
                list[editIdx] = rec;
            } else {
                list.push(rec);
            }
            delete s._syncedAt;
            saveCurrentHouseArch(s);
            measureFormState = null;
            renderContent();
        }

        // 内嵌表单照片/附件上传（与 handleMeasurePhotoUpload 逻辑一致，适配 data-*-field 输入框）
        function handleMeasureFormUpload(input) {
            const wrap = input.parentElement;
            const files = Array.from(input.files || []);
            if (!files.length) return;
            const urlInput = wrap.querySelector('.file-url-input');
            const isImageOnly = urlInput && urlInput.getAttribute('data-photo-type') === 'image';
            if (isImageOnly) {
                const invalid = files.find(f => !f.type.startsWith('image/'));
                if (invalid) { alert('请上传图片文件'); return; }
            }
            const existing = (urlInput.value || '').split(',').map(s => s.trim()).filter(Boolean);
            const readers = files.map(file => new Promise(resolve => {
                const reader = new FileReader();
                reader.onload = e => resolve(e.target.result);
                reader.readAsDataURL(file);
            }));
            Promise.all(readers).then(results => {
                const all = existing.concat(results).filter((v, i, a) => a.indexOf(v) === i);
                urlInput.value = all.join(',');
                urlInput.dispatchEvent(new Event('input'));
                let thumb = wrap.querySelector('.file-thumb-preview');
                if (!thumb) { thumb = document.createElement('div'); thumb.className = 'file-thumb-preview'; wrap.appendChild(thumb); }
                thumb.innerHTML = all.map(u => '<img src="' + u + '" alt="预览" onclick="viewPhotoOnline(\'' + u + '\')">').join('');
            });
        }

