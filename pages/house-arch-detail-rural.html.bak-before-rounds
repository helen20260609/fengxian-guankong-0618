    <title>房屋建筑档案 - 房屋安全管理</title>
    <link rel="stylesheet" href="./all.min.css">
    <script src="../js/third-party-data.js"></script>
    <script src="../js/house-arch-data.js"></script>
    <script>
        // =========================================================
        // 房屋建筑档案状态联动数据层（已接入 house-arch-data.js 统一数据层）
        // =========================================================

        function getUrlParam(key) {
            return new URLSearchParams(location.search).get(key) || '';
        }

        // 数据模式：'draft'（草稿，风险档案总览嵌入用，可编辑） / 'publish'（发布，房屋建筑档案入口，只读）
        // 兼容旧参数 readonly=1 → 视为 publish
        function getDataMode() {
            const m = getUrlParam('mode');
            if (m === 'draft' || m === 'publish') return m;
            if (getUrlParam('readonly') === '1') return 'publish';
            return 'publish'; // 默认发布区（只读）
        }
        const DATA_MODE = getDataMode();
        const IS_DRAFT_MODE = DATA_MODE === 'draft';

        // 只读模式：publish 模式下隐藏所有编辑入口
        (function applyReadonlyMode() {
            if (!IS_DRAFT_MODE) {
                const apply = function() {
                    document.body.classList.add('readonly-mode');
                    // 底部文案：“查看/编辑”→“查看”
                    document.querySelectorAll('.mode-label').forEach(function(el) { el.textContent = '查看'; });
                };
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', apply);
                } else {
                    // script 在 body 末尾，DOM 已 ready 但 renderContent 尚未执行，延迟到下一帧
                    setTimeout(apply, 0);
                }
            }
        })();

        // 草稿模式下显示同步按钮，绑定推送逻辑
        (function setupSyncButton() {
            if (!IS_DRAFT_MODE) return;
            const show = function() {
                const btn = document.getElementById('syncBtn');
                if (btn) btn.style.display = '';
            };
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', show);
            } else { show(); }
        })();

        // 同步草稿到发布区（房屋建筑档案）
        function syncToPublish() {
            const no = getCurrentHouseNo();
            if (typeof publishDraftRecord !== 'function') { alert('数据层未就绪'); return; }
            // 先把内存里最新的字段保存到草稿，再推送
            if (typeof saveCurrentHouseArch === 'function' && typeof currentHouseArch !== 'undefined') {
                saveCurrentHouseArch(currentHouseArch);
            }
            if (!confirm('确认将当前草稿同步到房屋建筑档案？\n同步后房屋建筑档案将显示本记录的最新内容。')) return;
            const r = publishDraftRecord(no, 'user');
            if (r && r.ok) {
                alert('✅ 已同步到房屋建筑档案');
                // 通知外层列表刷新状态
                if (window.parent && window.parent !== window) {
                    window.parent.postMessage({ action: 'draftSynced', no: no }, '*');
                }
            } else {
                alert('❌ 同步失败：' + (r && r.msg ? r.msg : '未知错误'));
            }
        }

        // 返回列表页：框架内则通知外层切回登记表列表，独立打开则后退
        // 携带来源类别参数，让列表页保持上次的农村/城镇TAB选中
        function goBackToList() {
            // 嵌入模式（草稿或只读）：来自风险档案总览嵌入层，通知外层关闭嵌入即可
            if (IS_DRAFT_MODE || getUrlParam('readonly') === '1') {
                if (window.parent && window.parent !== window) {
                    window.parent.postMessage({ action: 'closeDetailEmbed' }, '*');
                    return;
                }
            }
            const cat = getUrlParam('category') || (currentHouseArch && currentHouseArch.houseType) || '';
            const catQ = cat ? ('?category=' + encodeURIComponent(cat)) : '';
            if (window.parent && window.parent !== window) {
                window.parent.postMessage({ action: 'navigate', url: 'pages/hs-register.html' + catQ }, '*');
            } else {
                window.location.href = 'hs-register.html' + catQ;
            }
        }

        function getCurrentHouseNo() {
            const no = getUrlParam('no');
            if (no) return no;
            return getUrlParam('id') || 'NF-2025-00001';
        }

        // 兼容：house-arch-detail 原有局部函数优先调用统一数据层
        // 根据 DATA_MODE 选择读草稿区还是发布区
        function getCurrentHouseArch() {
            initHouseArchSeed();
            const no = getCurrentHouseNo();
            let rec;
            if (IS_DRAFT_MODE && typeof getDraftRecord === 'function') {
                rec = getDraftRecord(no); // 草稿区（无草稿自动回落到发布区）
            } else {
                rec = getHouseRecord(no); // 发布区
            }
            if (!rec) {
                rec = JSON.parse(JSON.stringify(DEFAULT_HOUSE_STATUS));
                rec.no = no;
                ensureHouseRecord(no);
            }
            ['manageRecords','projectRecords','qualityTrace'].forEach(k => {
                if (!Array.isArray(rec[k])) rec[k] = [];
            });
            if (!rec.emergencyResponse || typeof rec.emergencyResponse !== 'object') {
                rec.emergencyResponse = { planName: '', planDate: '', drillRecords: [] };
            }
            if (!Array.isArray(rec.emergencyResponse.drillRecords)) rec.emergencyResponse.drillRecords = [];
            // mock 一条示例演练记录（仅当为空）
            if (rec.emergencyResponse.drillRecords.length === 0) {
                rec.emergencyResponse.planName = rec.emergencyResponse.planName || (no + ' 房屋安全应急预案');
                rec.emergencyResponse.planDate = rec.emergencyResponse.planDate || '2024-02-02';
                rec.emergencyResponse.drillRecords.push({
                    drillDate: '2024-07-11',
                    drillOrg: '南桥镇应急管理办',
                    drillContent: '房屋安全隐患应急疏散演练',
                    participants: 13,
                    remark: '演练达到预期效果'
                });
            }
            // 阶段性验收：在 projectRecords[0] 上挂默认字段（仅当缺失）
            if (!rec.projectRecords.length) rec.projectRecords.push({ id: 'PRJ-' + no + '-001' });
            const prj0 = rec.projectRecords[0];
            if (prj0.acceptMethod === undefined) prj0.acceptMethod = '现场验收';
            if (prj0.hasAppraisalAfter === undefined) prj0.hasAppraisalAfter = '是';
            if (prj0.thirdPartyResult === undefined) prj0.thirdPartyResult = '待复核';
            if (prj0.manager === undefined) prj0.manager = rec.responsiblePerson || '张伟';
            if (prj0.phone === undefined) prj0.phone = '136-0000-1234';
            if (prj0.acceptRemark === undefined) prj0.acceptRemark = '按计划推进整治';
            if (prj0.reporter === undefined) prj0.reporter = rec.responsiblePerson || '李志强';
            if (prj0.acceptReportTime === undefined) prj0.acceptReportTime = '2024-09-30 10:00';
            if (!Array.isArray(prj0.rectifyPhotos)) prj0.rectifyPhotos = [];
            if (!Array.isArray(prj0.relatedFiles)) prj0.relatedFiles = [];
            // 验收销项：closeInfo 默认值
            if (!rec.closeInfo || typeof rec.closeInfo !== 'object') rec.closeInfo = {};
            const ci = rec.closeInfo;
            const isDoneDef = rec.governance === 'done';
            if (ci.closeMethod === undefined) ci.closeMethod = isDoneDef ? '工程整治销项' : '—';
            if (ci.hazardEliminated === undefined) ci.hazardEliminated = isDoneDef ? '是' : '—';
            if (ci.appraisalAfter === undefined) ci.appraisalAfter = (rec.appraisalReports || []).length ? '是' : '—';
            if (ci.thirdPartyResult === undefined) ci.thirdPartyResult = isDoneDef ? '复核合格' : '—';
            if (ci.contactName === undefined) ci.contactName = prj0.manager || rec.responsiblePerson || '王建国';
            if (ci.contactPhone === undefined) ci.contactPhone = prj0.phone || rec.managerPhone || '139-5678-1234';
            if (ci.infoUpdated === undefined) ci.infoUpdated = '—';
            if (ci.remark === undefined) ci.remark = '已落实封控警示措施';
            if (ci.reporter === undefined) ci.reporter = prj0.reporter || rec.responsiblePerson || '王建国';
            if (ci.reportTime === undefined) ci.reportTime = rec.closeApplyTime || '2025-02-02';
            if (!Array.isArray(ci.completeCertFiles)) ci.completeCertFiles = [];
            if (!Array.isArray(ci.expertOpinionFiles)) ci.expertOpinionFiles = [];
            if (!Array.isArray(ci.afterPhotos)) ci.afterPhotos = [];
            if (!Array.isArray(ci.relatedFiles)) ci.relatedFiles = [];
            if (!Array.isArray(prj0.implementPhotos)) prj0.implementPhotos = [];
            if (!Array.isArray(prj0.completePhotos)) prj0.completePhotos = [];
            // 工程措施：projectRecords[0] 默认值（仅当缺失）
            if (prj0.taskNo === undefined) prj0.taskNo = 'NF-2025-00001';
            if (prj0.projectName === undefined) prj0.projectName = '基础加固';
            if (prj0.measureType === undefined) prj0.measureType = '基础加固';
            if (prj0.implementScope === undefined) prj0.implementScope = '整栋房屋';
            if (prj0.policyPath === undefined) prj0.policyPath = '区级修缮工程补贴';
            if (prj0.otherPolicyPath === undefined) prj0.otherPolicyPath = '—';
            if (prj0.planDetail === undefined) prj0.planDetail = '—';
            if (prj0.startDate === undefined) prj0.startDate = '2024-10-03';
            if (prj0.endDate === undefined) prj0.endDate = '—';
            if (prj0.company === undefined) prj0.company = '华建工程公司';
            if (prj0.manager === undefined) prj0.manager = '陈明华';
            if (prj0.phone === undefined) prj0.phone = '136-0000-1234';
            if (prj0.budget === undefined) prj0.budget = '1.08';
            if (prj0.fundSource === undefined) prj0.fundSource = '区级修缮补贴60%+业主自筹40%';
            if (prj0.acceptConclusion === undefined) prj0.acceptConclusion = '—';
            if (prj0.acceptUnit === undefined) prj0.acceptUnit = '—';
            if (prj0.acceptChecker === undefined) prj0.acceptChecker = '—';
            if (prj0.acceptDate === undefined) prj0.acceptDate = '—';
            if (prj0.status === undefined) prj0.status = '进行中';
            if (prj0.remark === undefined) prj0.remark = '施工进行中，进度约50%';
            if (prj0.reporter === undefined) prj0.reporter = '陈明华';
            if (prj0.reportTime === undefined) prj0.reportTime = '2024-10-03 08:00';
            if (!Array.isArray(prj0.planFiles)) prj0.planFiles = [];
            if (!Array.isArray(prj0.designFiles)) prj0.designFiles = [];
            if (!Array.isArray(prj0.orgDesignFiles)) prj0.orgDesignFiles = [];
            if (!Array.isArray(prj0.safetyFiles)) prj0.safetyFiles = [];
            if (!Array.isArray(prj0.baseAcceptFiles)) prj0.baseAcceptFiles = [];
            if (!Array.isArray(prj0.mainAcceptFiles)) prj0.mainAcceptFiles = [];
            if (!Array.isArray(prj0.materialFiles)) prj0.materialFiles = [];
            if (!Array.isArray(prj0.completeReportFiles)) prj0.completeReportFiles = [];
            if (!Array.isArray(prj0.rectifyPhotos)) prj0.rectifyPhotos = [];
            // 农村专属页: 强制 houseType 为农村(路由/兜底以此为准, 不受表单房屋性质影响)
            rec.houseType = '农村自建房';
            return rec;
        }

        // 字段库 → 根级字段映射（保存时同步）
        function syncLibToRootFields(record) {
            if (!record || !record._fieldsLibrary) return record;
            const lib = record._fieldsLibrary;
            const jbxx = lib.basic_RURAL?.jbxx || lib.basic_URBAN?.jbxx || [];
            function getVal(label) {
                const r = jbxx.find(row => row[0] === label);
                return r ? r[1] : undefined;
            }
            // 产权人 / 使用人信息 → owner
            const owner = getVal('产权人 / 使用人信息');
            if (owner !== undefined && owner !== '—') record.owner = owner;
            // 所在区域 → street（去掉"奉贤区"前缀）
            const area = getVal('所在区域');
            if (area !== undefined && area !== '—') {
                record.street = area.replace(/^奉贤区/, '');
            }
            // 房屋性质 → houseType
            const ht = getVal('房屋性质');
            if (ht !== undefined && ht !== '—') record.houseType = ht;
            // 路号信息 → address
            const addr = getVal('路号信息');
            if (addr !== undefined && addr !== '—') record.address = addr;
            return record;
        }

        function saveCurrentHouseArch(status) {
            const no = getCurrentHouseNo();
            // 同步字段库到根级字段
            status = syncLibToRootFields(status);
            if (IS_DRAFT_MODE && typeof setDraftRecord === 'function') {
                setDraftRecord(no, status); // 草稿区
            } else {
                const all = getHouseArchStorage();
                all[no] = status;
                setHouseArchStorage(all); // 发布区
            }
        }

        function generateArchId(prefix) {
            const d = new Date();
            const pad = n => n < 10 ? '0' + n : n;
            const ts = d.getFullYear() + pad(d.getMonth()+1) + pad(d.getDate()) + '-' +
                       pad(d.getHours()) + pad(d.getMinutes()) + pad(d.getSeconds());
            return prefix + '-' + ts + '-' + Math.floor(Math.random()*900 + 100);
        }
