        function handleCloseDetailPhotoUpload(input, key) {
            const files = Array.from(input.files || []);
            if (!files.length) return;
            const wrap = input.closest('.file-upload-wrap');
            const urlInput = wrap.querySelector('[data-ckey="' + key + '"]');
            const readers = files.map(f => new Promise(res => {
                const r = new FileReader();
                r.onload = e => res(e.target.result);
                r.readAsDataURL(f);
            }));
            Promise.all(readers).then(urls => {
                const cur = urlInput.value ? urlInput.value.split(',').map(s => s.trim()).filter(Boolean) : [];
                urlInput.value = cur.concat(urls).join(',');
            });
        }

