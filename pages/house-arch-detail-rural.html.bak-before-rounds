        // 通用字段/记录列表帮助函数（全局，供基础信息、风险信息记录等模块复用）
        function kv(label, value, emptyLabel, ruralOnly) {
            const v = value || '';
            const isEmpty = v === '' || v === null || v === undefined;
            const cls = isEmpty ? 'empty' : (ruralOnly ? 'rural-only' : '');
            return '<div class="info-item"><div class="info-label">' + label + '</div><div class="info-value ' + cls + '">' + (isEmpty ? (emptyLabel || '—') : v) + '</div></div>';
        }
        function recordListTable(columns, rows, moduleKey, activeIndex, options) {
            options = options || {};
            if (!rows || rows.length === 0) return '<div class="record-empty">暂无记录</div>';
            const showCrud = options.showCrud; // {edit: fn, delete: fn}
            const head = '<thead><tr>' + columns.map(c => '<th>' + (c.title || c) + '</th>').join('') + (options.showAction || showCrud ? '<th>操作</th>' : '') + '</tr></thead>';
            const body = rows.map(function(row, idx) {
                const isActive = idx === activeIndex;
                const cells = row.map(function(cell, cIdx) {
                    const col = columns[cIdx] || {};
                    const val = (cell === undefined || cell === '' || cell === null) ? '—' : cell;
                    if (col.tag) return '<td><span class="tag ' + (col.tagClass ? col.tagClass(val) : 'info') + '">' + val + '</span></td>';
                    return '<td>' + val + '</td>';
                }).join('');
                let actionCell = '';
                if (showCrud) {
                    // showCrud.edit/delete 是函数调用前缀，如 "openCrudModal('measureProject'"，这里补全参数
                    actionCell = '<td class="actions">' +
                        '<a class="view-link" href="javascript:void(0)" onclick="' + showCrud.edit + ',' + idx + ')">编辑</a>' +
                        '<a class="view-link" href="javascript:void(0)" onclick="' + showCrud.delete + ',' + idx + ')" style="color:var(--danger);">删除</a>' +
                    '</td>';
                } else if (options.showAction) {
                    actionCell = '<td class="actions"><a class="view-link" href="javascript:void(0);">查看</a></td>';
                }
                return '<tr class="record-list-row ' + (isActive ? 'active' : '') + '" data-module="' + moduleKey + '" data-index="' + idx + '">' + cells + actionCell + '</tr>';
            }).join('');
            return '<div class="table-scroll"><table class="record-list">' + head + '<tbody>' + body + '</tbody></table></div>';
        }
