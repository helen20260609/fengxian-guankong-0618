        function deleteCrudRecord(moduleKey, idx) {
            if (!confirm('确定删除这条记录吗？')) return;
            const cfg = crudConfigs[moduleKey];
            if (!cfg) return;
            const s = currentHouseArch;
            const list = (getNestedValue(s, cfg.dataPath) || []).slice();
            list.splice(idx, 1);
            setNestedValue(s, cfg.dataPath, list);
            saveCurrentHouseArch(s);
            renderContent();
